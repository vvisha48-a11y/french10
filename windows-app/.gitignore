# Everything listed here is rebuilt by npm install / npm run sync / npm run dist,
# so none of it belongs in git -- together it is well over a gigabyte.
# (Comments must sit on their own line: anything after a pattern becomes part of it.)

# the Electron runtime and the Google Drive libraries
node_modules/

# this app's own copy of the website, rebuilt by: npm run sync
content/

# the downloaded Firebase SDK, kept between syncs
.cache/

# the installer: release/French-Grammar-Setup.exe, about 147 MB
release/

# an older build folder, same idea
dist/

# never commit a token: electron-builder's CLI reads this file if it exists
electron-builder.env
.env
