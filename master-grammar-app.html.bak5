r-notes{display:block}@media screen and (min-width:1600px){.reveal .speaker-notes{font-size:20px}}@media screen and (max-width:1024px){.reveal.show-notes{border-left:0;max-width:none;max-height:70%;max-height:70vh;overflow:visible}.reveal.show-notes .speaker-notes{top:100%;left:0;width:100%;height:30vh;border:0}}@media screen and (max-width:600px){.reveal.show-notes{max-height:60%;max-height:60vh}.reveal.show-notes .speaker-notes{top:100%;height:40vh}.reveal .speaker-notes{font-size:14px}}.reveal .jump-to-slide{position:absolute;top:15px;left:15px;z-index:30;font-size:32px;-webkit-tap-highlight-color:transparent}.reveal .jump-to-slide-input{background:0 0;padding:8px;font-size:inherit;color:currentColor;border:0}.reveal .jump-to-slide-input::placeholder{color:currentColor;opacity:.5}.reveal.has-dark-background .jump-to-slide-input{color:#fff}.reveal.has-light-background .jump-to-slide-input{color:#222}.reveal .jump-to-slide-input:focus{outline:0}.zoomed .reveal *,.zoomed .reveal :after,.zoomed .reveal :before{backface-visibility:visible!important}.zoomed .reveal .controls,.zoomed .reveal .progress{opacity:0}.zoomed .reveal .roll span{background:0 0}.zoomed .reveal .roll span:after{visibility:hidden}html.print-pdf *{-webkit-print-color-adjust:exact}html.print-pdf{width:100%;height:100%;overflow:visible}html.print-pdf body{margin:0 auto!important;border:0;padding:0;float:none!important;overflow:visible}html.print-pdf .nestedarrow,html.print-pdf .reveal .controls,html.print-pdf .reveal .playback,html.print-pdf .reveal .progress,html.print-pdf .reveal.overview,html.print-pdf .state-background{display:none!important}html.print-pdf .reveal pre code{overflow:hidden!important}html.print-pdf .reveal{width:auto!important;height:auto!important;overflow:hidden!important}html.print-pdf .reveal .slides{position:static;width:100%!important;height:auto!important;zoom:1!important;pointer-events:initial;left:auto;top:auto;margin:0!important;padding:0!important;overflow:visible;display:block;perspective:none;perspective-origin:50% 50%}html.print-pdf .reveal .slides .pdf-page{position:relative;overflow:hidden;z-index:1;page-break-after:always}html.print-pdf .reveal .slides section{visibility:visible!important;display:block!important;position:absolute!important;margin:0!important;padding:0!important;box-sizing:border-box!important;min-height:1px;opacity:1!important;transform-style:flat!important;transform:none!important}html.print-pdf .reveal section.stack{position:relative!important;margin:0!important;padding:0!important;page-break-after:avoid!important;height:auto!important;min-height:auto!important}html.print-pdf .reveal img{box-shadow:none}html.print-pdf .reveal .backgrounds{display:none}html.print-pdf .reveal .slide-background{display:block!important;position:absolute;top:0;left:0;width:100%;height:100%;z-index:auto!important}html.print-pdf .reveal.show-notes{max-width:none;max-height:none}html.print-pdf .reveal .speaker-notes-pdf{display:block;width:100%;height:auto;max-height:none;top:auto;right:auto;bottom:auto;left:auto;z-index:100}html.print-pdf .reveal .speaker-notes-pdf[data-layout=separate-page]{position:relative;color:inherit;background-color:transparent;padding:20px;page-break-after:always;border:0}html.print-pdf .reveal .slide-number-pdf{display:block;position:absolute;font-size:14px}html.print-pdf .aria-status{display:none}@media print{html:not(.print-pdf){overflow:visible;width:auto;height:auto}html:not(.print-pdf) body{margin:0;padding:0;overflow:visible}html:not(.print-pdf) .reveal{background:#fff;font-size:20pt}html:not(.print-pdf) .reveal .backgrounds,html:not(.print-pdf) .reveal .controls,html:not(.print-pdf) .reveal .progress,html:not(.print-pdf) .reveal .slide-number,html:not(.print-pdf) .reveal .state-background{display:none!important}html:not(.print-pdf) .reveal li,html:not(.print-pdf) .reveal p,html:not(.print-pdf) .reveal td{font-size:20pt!important;color:#000}html:not(.print-pdf) .reveal h1,html:not(.print-pdf) .reveal h2,html:not(.print-pdf) .reveal h3,html:not(.print-pdf) .reveal h4,html:not(.print-pdf) .reveal h5,html:not(.print-pdf) .reveal h6{color:#000!important;height:auto;line-height:normal;text-align:left;letter-spacing:normal}html:not(.print-pdf) .reveal h1{font-size:28pt!important}html:not(.print-pdf) .reveal h2{font-size:24pt!important}html:not(.print-pdf) .reveal h3{font-size:22pt!important}html:not(.print-pdf) .reveal h4{font-size:22pt!important;font-variant:small-caps}html:not(.print-pdf) .reveal h5{font-size:21pt!important}html:not(.print-pdf) .reveal h6{font-size:20pt!important;font-style:italic}html:not(.print-pdf) .reveal a:link,html:not(.print-pdf) .reveal a:visited{color:#000!important;font-weight:700;text-decoration:underline}html:not(.print-pdf) .reveal div,html:not(.print-pdf) .reveal ol,html:not(.print-pdf) .reveal p,html:not(.print-pdf) .reveal ul{visibility:visible;position:static;width:auto;height:auto;display:block;overflow:visible;margin:0;text-align:left!important}html:not(.print-pdf) .reveal pre,html:not(.print-pdf) .reveal table{margin-left:0;margin-right:0}html:not(.print-pdf) .reveal pre code{padding:20px}html:not(.print-pdf) .reveal blockquote{margin:20px 0}html:not(.print-pdf) .reveal .slides{position:static!important;width:auto!important;height:auto!important;left:0!important;top:0!important;margin-left:0!important;margin-top:0!important;padding:0!important;zoom:1!important;transform:none!important;overflow:visible!important;display:block!important;text-align:left!important;perspective:none;perspective-origin:50% 50%}html:not(.print-pdf) .reveal .slides section{visibility:visible!important;position:static!important;width:auto!important;height:auto!important;display:block!important;overflow:visible!important;left:0!important;top:0!important;margin-left:0!important;margin-top:0!important;padding:60px 20px!important;z-index:auto!important;opacity:1!important;page-break-after:always!important;transform-style:flat!important;transform:none!important;transition:none!important}html:not(.print-pdf) .reveal .slides section.stack{padding:0!important}html:not(.print-pdf) .reveal .slides section:last-of-type{page-break-after:avoid!important}html:not(.print-pdf) .reveal .slides section .fragment{opacity:1!important;visibility:visible!important;transform:none!important}html:not(.print-pdf) .reveal .r-fit-text{white-space:normal!important}html:not(.print-pdf) .reveal section img{display:block;margin:15px 0;background:#fff;border:1px solid #666;box-shadow:none}html:not(.print-pdf) .reveal section small{font-size:.8em}html:not(.print-pdf) .reveal .hljs{max-height:100%;white-space:pre-wrap;word-wrap:break-word;word-break:break-word;font-size:15pt}html:not(.print-pdf) .reveal .hljs .hljs-ln-numbers{white-space:nowrap}html:not(.print-pdf) .reveal .hljs td{font-size:inherit!important;color:inherit!important}}
</style>

<style>
/* ============================================================
   MASTER GRAMMAR APP — CBSE Class 10 French
   Engine ported from "Les Verbes - Tous les Temps.html" and the
   cbse-french-grammar-presentation skill template, with all
   page-global widget IDs replaced by per-sub-topic scoping.
   ============================================================ */

:root{
  --custom-font-family:'Plus Jakarta Sans', sans-serif;
  --custom-heading-font:'Outfit', sans-serif;
  --custom-font-scale:1;
  /* NOTE: --custom-text-color is deliberately NOT set here. Themes fall back
     to their own text colour until the user picks a preset. Setting it here
     is what made the dark theme unreadable in the original engine. */
  --topbar-h:56px;
  --hud-h:54px;
  --sidebar-w:250px;
}

/* ============ THEMES (6) ============ */
body.theme-classic{
  --bg-gradient: radial-gradient(circle at 50% 20%, #eef4fc 0%, #dbeafe 55%, #bfdbfe 100%);
  --card-bg: rgba(255,255,255,0.95); --card-border: rgba(0,35,149,0.2);
  --text-main: var(--custom-text-color,#0f172a); --text-muted:#475569;
  --heading-color:#002395; --subheading-color:#ED2939;
  --highlight-bg: rgba(0,35,149,0.12); --highlight-border:#002395; --highlight-text:#002395;
  --box-blue-bg:#eef4fc; --box-gold-bg:#fff8eb; --box-gold-border:#f4b436;
  --hud-bg: rgba(255,255,255,0.94); --hud-text:#002395; --particle-color: rgba(0,35,149,0.3);
  --green:#047857; --purple:#7e22ce; --gold:#D97706; --crimson:#ED2939;
  --ok:#047857; --err:#dc2626;
}
body.theme-cyber{
  --bg-gradient: radial-gradient(circle at 50% 20%, #0b0f19 0%, #030712 60%, #000 100%);
  --card-bg: rgba(15,23,42,0.9); --card-border: rgba(0,242,254,0.35);
  --text-main: var(--custom-text-color,#f8fafc); --text-muted:#94a3b8;
  --heading-color:#00f2fe; --subheading-color:#ff2a4b;
  --highlight-bg: rgba(0,242,254,0.18); --highlight-border:#00f2fe; --highlight-text:#00f2fe;
  --box-blue-bg: rgba(0,102,255,0.14); --box-gold-bg: rgba(255,190,11,0.10); --box-gold-border:#ffbe0b;
  --hud-bg: rgba(15,23,42,0.92); --hud-text:#00f2fe; --particle-color: rgba(0,242,254,0.4);
  --green:#22d3ee; --purple:#c084fc; --gold:#ffbe0b; --crimson:#ff2a4b;
  --ok:#22d3ee; --err:#ff2a4b;
}
body.theme-slate{
  --bg-gradient: radial-gradient(circle at 50% 15%, #1e293b 0%, #0f172a 60%, #020617 100%);
  --card-bg: rgba(30,41,59,0.92); --card-border: rgba(148,163,184,0.32);
  --text-main: var(--custom-text-color,#f1f5f9); --text-muted:#cbd5e1;
  --heading-color:#7dd3fc; --subheading-color:#fda4af;
  --highlight-bg: rgba(125,211,252,0.18); --highlight-border:#7dd3fc; --highlight-text:#bae6fd;
  --box-blue-bg: rgba(56,189,248,0.12); --box-gold-bg: rgba(251,191,36,0.12); --box-gold-border:#fbbf24;
  --hud-bg: rgba(15,23,42,0.94); --hud-text:#7dd3fc; --particle-color: rgba(148,163,184,0.35);
  --green:#4ade80; --purple:#d8b4fe; --gold:#fbbf24; --crimson:#fb7185;
  --ok:#4ade80; --err:#fb7185;
}
body.theme-sunrise{
  --bg-gradient: radial-gradient(circle at 50% 20%, #fffbeb 0%, #fef3c7 55%, #fde68a 100%);
  --card-bg: rgba(255,255,255,0.95); --card-border: rgba(217,119,6,0.25);
  --text-main: var(--custom-text-color,#451a03); --text-muted:#78350f;
  --heading-color:#b45309; --subheading-color:#991b1b;
  --highlight-bg: rgba(217,119,6,0.15); --highlight-border:#b45309; --highlight-text:#92400e;
  --box-blue-bg:#eff6ff; --box-gold-bg:#fffbe3; --box-gold-border:#d97706;
  --hud-bg: rgba(255,255,255,0.94); --hud-text:#b45309; --particle-color: rgba(217,119,6,0.35);
  --green:#15803d; --purple:#7e22ce; --gold:#b45309; --crimson:#991b1b;
  --ok:#15803d; --err:#991b1b;
}
body.theme-emerald{
  --bg-gradient: radial-gradient(circle at 50% 20%, #ecfdf5 0%, #d1fae5 55%, #a7f3d0 100%);
  --card-bg: rgba(255,255,255,0.95); --card-border: rgba(16,185,129,0.3);
  --text-main: var(--custom-text-color,#064e3b); --text-muted:#047857;
  --heading-color:#047857; --subheading-color:#b91c1c;
  --highlight-bg: rgba(16,185,129,0.15); --highlight-border:#059669; --highlight-text:#047857;
  --box-blue-bg:#e0f2fe; --box-gold-bg:#fefce8; --box-gold-border:#eab308;
  --hud-bg: rgba(255,255,255,0.94); --hud-text:#047857; --particle-color: rgba(16,185,129,0.35);
  --green:#047857; --purple:#7e22ce; --gold:#b45309; --crimson:#b91c1c;
  --ok:#047857; --err:#b91c1c;
}
body.theme-purple{
  --bg-gradient: radial-gradient(circle at 50% 20%, #faf5ff 0%, #f3e8ff 55%, #e9d5ff 100%);
  --card-bg: rgba(255,255,255,0.95); --card-border: rgba(168,85,247,0.3);
  --text-main: var(--custom-text-color,#3b0764); --text-muted:#6b21a8;
  --heading-color:#7e22ce; --subheading-color:#be185d;
  --highlight-bg: rgba(168,85,247,0.15); --highlight-border:#9333ea; --highlight-text:#6b21a8;
  --box-blue-bg:#f0f9ff; --box-gold-bg:#fefce8; --box-gold-border:#eab308;
  --hud-bg: rgba(255,255,255,0.94); --hud-text:#7e22ce; --particle-color: rgba(168,85,247,0.35);
  --green:#047857; --purple:#7e22ce; --gold:#b45309; --crimson:#be185d;
  --ok:#047857; --err:#be185d;
}
body.theme-minimal{
  --bg-gradient: radial-gradient(circle at 50% 20%, #f8fafc 0%, #f1f5f9 55%, #e2e8f0 100%);
  --card-bg:#ffffff; --card-border:#cbd5e1;
  --text-main: var(--custom-text-color,#0f172a); --text-muted:#475569;
  --heading-color:#1e293b; --subheading-color:#2563eb;
  --highlight-bg:#e2e8f0; --highlight-border:#2563eb; --highlight-text:#1d4ed8;
  --box-blue-bg:#f1f5f9; --box-gold-bg:#f8fafc; --box-gold-border:#64748b;
  --hud-bg:#ffffff; --hud-text:#0f172a; --particle-color: rgba(100,116,139,0.3);
  --green:#047857; --purple:#7e22ce; --gold:#b45309; --crimson:#dc2626;
  --ok:#047857; --err:#dc2626;
}

/* ============ BASE ============ */
*{ box-sizing:border-box; }
html, body{
  width:100vw; height:100vh; margin:0; padding:0; overflow:hidden;
  background:#020617;
}
body{
  font-family:var(--custom-font-family);
  color:var(--text-main);
  background:var(--bg-gradient);
  background-attachment:fixed;
  transition:background .5s ease, color .3s ease;
}
canvas.fx-layer{ position:fixed; inset:0; pointer-events:none; }
#ambientParticlesCanvas{ z-index:1; }
#fireworksCanvas{ z-index:2; }
#confettiCanvas{ z-index:3; }

h1,h2,h3,h4{ font-family:var(--custom-heading-font); color:var(--heading-color); margin:0 0 10px; line-height:1.15; }
h1{ font-size:calc(2.5rem * var(--custom-font-scale)); font-weight:900; }
h2{ font-size:calc(1.95rem * var(--custom-font-scale)); font-weight:800; }
h3{ font-size:calc(1.3rem * var(--custom-font-scale)); font-weight:700; }
p{ font-size:calc(1.08rem * var(--custom-font-scale)); line-height:1.55; margin:0 0 8px; color:var(--text-main); }

/* ============ TOP BAR ============ */
.topbar{
  position:fixed; top:0; left:0; right:0; height:var(--topbar-h); z-index:40;
  display:flex; align-items:center; gap:10px; padding:0 14px;
  background:var(--hud-bg); backdrop-filter:blur(10px);
  border-bottom:1px solid var(--card-border);
}
.topbar .brand{
  font-family:var(--custom-heading-font); font-weight:900; font-size:1.02rem;
  color:var(--hud-text); white-space:nowrap; margin-right:4px;
}
.tb-btn{
  font-family:inherit; font-size:.86rem; font-weight:700; cursor:pointer;
  padding:8px 12px; border-radius:10px; white-space:nowrap;
  background:var(--highlight-bg); color:var(--hud-text);
  border:1px solid var(--card-border); transition:all .18s ease;
}
.tb-btn:hover{ border-color:var(--highlight-border); transform:translateY(-1px); }
.tb-btn.is-on{ background:var(--highlight-border); color:#fff; }
.tb-spacer{ flex:1; }

/* Topic dropdown */
.topic-menu-wrap{ position:relative; }
.topic-menu{
  position:absolute; top:calc(100% + 8px); left:0; width:340px; max-height:70vh; overflow-y:auto;
  background:var(--card-bg); border:1px solid var(--card-border); border-radius:14px;
  box-shadow:0 18px 50px rgba(0,0,0,.3); padding:8px; z-index:50;
  opacity:0; visibility:hidden; transform:translateY(-8px); transition:all .2s ease;
}
.topic-menu.open{ opacity:1; visibility:visible; transform:translateY(0); }
.topic-menu-item{
  display:flex; align-items:center; gap:10px; width:100%; text-align:left;
  padding:10px 12px; border-radius:10px; cursor:pointer;
  background:transparent; border:none; color:var(--text-main);
  font-family:inherit; font-size:.92rem; font-weight:600;
}
.topic-menu-item:hover{ background:var(--highlight-bg); }
.topic-menu-item .tm-num{
  width:24px; height:24px; flex:none; border-radius:50%;
  background:var(--highlight-border); color:#fff;
  font-size:.72rem; font-weight:800; display:grid; place-items:center;
}
.topic-menu-item .tm-pct{ margin-left:auto; font-size:.75rem; color:var(--text-muted); font-weight:700; }

/* ============ SIDEBAR ============ */
.sidebar{
  position:fixed; top:var(--topbar-h); right:0; bottom:var(--hud-h); width:var(--sidebar-w); z-index:30;
  background:var(--hud-bg); border-left:1px solid var(--card-border);
  padding:12px 10px; overflow-y:auto; transition:transform .3s ease;
}
body.sidebar-hidden .sidebar{ transform:translateX(100%); }
.sb-title{
  font-family:var(--custom-heading-font); font-size:.72rem; font-weight:800;
  text-transform:uppercase; letter-spacing:.08em; color:var(--text-muted);
  margin:6px 4px 8px;
}
.sb-item{
  display:block; width:100%; text-align:left; cursor:pointer;
  padding:7px 10px; margin-bottom:3px; border-radius:8px;
  background:transparent; border:none; color:var(--text-main);
  font-family:inherit; font-size:.83rem; font-weight:600; line-height:1.3;
}
.sb-item:hover{ background:var(--highlight-bg); }
.sb-item.active{ background:var(--highlight-border); color:#fff; }
.sb-item.step{ font-size:.79rem; padding-left:20px; position:relative; font-weight:500; }
.sb-item.step::before{
  content:''; position:absolute; left:9px; top:50%; transform:translateY(-50%);
  width:5px; height:5px; border-radius:50%; background:var(--text-muted);
}
.sb-item.step.active::before{ background:#fff; }
.sb-divider{ height:1px; background:var(--card-border); margin:10px 4px; }

/* ============ REVEAL VIEWPORT ============ */
.reveal-shell{
  position:fixed; top:var(--topbar-h); left:0; bottom:var(--hud-h); right:var(--sidebar-w);
  z-index:10; transition:right .3s ease;
}
body.sidebar-hidden .reveal-shell{ right:0; }
.reveal{ width:100%; height:100%; }
.reveal .slides{ text-align:center; }
.reveal .slides section{ height:100%; }

/* ============ SLIDE CARD ============ */
.slide-card{
  position:relative;
  width:94%; max-width:1420px; height:100%;
  margin:0 auto; padding:26px 40px 18px;
  display:flex; flex-direction:column; align-items:center; justify-content:flex-start;
  text-align:center; overflow-y:auto; overflow-x:hidden;
  background:var(--card-bg); border:1px solid var(--card-border);
  border-radius:22px; box-shadow:0 18px 50px rgba(0,0,0,.14);
}
.slide-card::-webkit-scrollbar{ width:8px; }
.slide-card::-webkit-scrollbar-thumb{ background:var(--card-border); border-radius:4px; }
.flag-stripe{
  position:absolute; top:0; left:0; right:0; height:5px; border-radius:22px 22px 0 0;
  background:linear-gradient(90deg,#002395 0 33.3%,#ffffff 33.3% 66.6%,#ED2939 66.6% 100%);
}
.svg-badge{ width:52px; height:52px; margin:2px auto 6px; flex:none; }

/* Step ribbon — tells students exactly where they are in the 8-slide cycle */
.step-ribbon{
  display:inline-flex; align-items:center; gap:8px; flex:none;
  padding:5px 14px; margin:2px 0 10px; border-radius:999px;
  background:var(--highlight-bg); border:1px solid var(--highlight-border);
  color:var(--highlight-text); font-size:.78rem; font-weight:800;
  text-transform:uppercase; letter-spacing:.06em;
}
.step-ribbon .sr-n{
  width:20px; height:20px; border-radius:50%; background:var(--highlight-border);
  color:#fff; display:grid; place-items:center; font-size:.68rem;
}
.usage-badge{
  display:inline-block; padding:5px 14px; margin-bottom:8px; border-radius:999px;
  background:var(--gold); color:#fff; font-size:.8rem; font-weight:800;
}

/* ============ CONTENT BOXES ============ */
.content-box{ width:100%; max-width:1340px; }
.box{
  background:var(--card-bg); border:1.5px solid var(--card-border);
  border-radius:16px; padding:14px 20px; margin:8px auto; text-align:left;
}
.box.blue{ background:var(--box-blue-bg); border-top:4px solid var(--heading-color); }
.box.gold{ background:var(--box-gold-bg); border-top:4px solid var(--box-gold-border); }
.box.green{ background:var(--box-blue-bg); border-top:4px solid var(--green); }
.box.red{ background:var(--box-gold-bg); border-top:4px solid var(--crimson); }
.two-columns{ display:grid; grid-template-columns:1fr 1fr; gap:14px; align-items:start; width:100%; max-width:1360px; }
.three-columns{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; align-items:start; width:100%; max-width:1380px; }
@media (max-width:1100px){ .two-columns,.three-columns{ grid-template-columns:1fr; } }

/* ============ COLOUR-CODED GRAMMAR ROLES ============ */
.highlight{
  display:inline-block; padding:2px 9px; border-radius:7px;
  background:var(--highlight-bg); color:var(--highlight-text);
  border:1px solid var(--highlight-border); font-weight:800;
}
.hl-subject{ background:rgba(0,35,149,.14); color:#002395; border-color:#002395; }
.hl-neg    { background:rgba(237,41,57,.14); color:#ED2939; border-color:#ED2939; }
.hl-verb   { background:rgba(4,120,87,.14);  color:#047857; border-color:#047857; }
.hl-aux    { background:rgba(217,119,6,.16); color:#D97706; border-color:#D97706; }
.hl-pronoun{ background:rgba(126,34,206,.14);color:#7e22ce; border-color:#7e22ce; }
/* Dark themes need lighter role colours to stay legible on the card */
body.theme-cyber .hl-subject, body.theme-slate .hl-subject{ color:#93c5fd; border-color:#60a5fa; background:rgba(96,165,250,.16); }
body.theme-cyber .hl-neg,     body.theme-slate .hl-neg    { color:#fda4af; border-color:#fb7185; background:rgba(251,113,133,.16); }
body.theme-cyber .hl-verb,    body.theme-slate .hl-verb   { color:#6ee7b7; border-color:#34d399; background:rgba(52,211,153,.16); }
body.theme-cyber .hl-aux,     body.theme-slate .hl-aux    { color:#fcd34d; border-color:#fbbf24; background:rgba(251,191,36,.16); }
body.theme-cyber .hl-pronoun, body.theme-slate .hl-pronoun{ color:#d8b4fe; border-color:#c084fc; background:rgba(192,132,252,.16); }

/* Enlarged key forms, per AGENTS.md */
.key-form{ font-size:calc(1.35em * var(--custom-font-scale)); color:#002395; font-weight:800; }
body.theme-cyber .key-form, body.theme-slate .key-form{ color:#7dd3fc; }

.example-text{ font-style:italic; font-size:calc(1.04rem * var(--custom-font-scale)); margin:4px 0; }
.gloss{ font-style:normal; color:var(--text-muted); font-size:.9em; }
.gloss::before{ content:'↳ '; opacity:.6; }

/* ============ TABLES ============ */
.subj-table{ width:100%; border-collapse:collapse; font-size:calc(1rem * var(--custom-font-scale)); }
.subj-table td, .subj-table th{ padding:6px 10px; border-bottom:1px solid var(--card-border); text-align:left; }
.subj-table th{ font-weight:800; color:var(--heading-color); }
.subj-table tr:last-child td{ border-bottom:none; }

/* ============ FORMULA PIPELINE ============ */
.formula-pipeline{ display:grid; grid-template-columns:1fr auto 1fr auto 1.2fr; gap:10px; align-items:center; width:100%; max-width:1300px; margin:8px auto; }
.f-box{ background:var(--box-blue-bg); border:2px solid var(--heading-color); border-radius:14px; padding:12px 10px; text-align:center; }
.f-box .f-label{ font-size:.72rem; font-weight:800; text-transform:uppercase; letter-spacing:.06em; color:var(--text-muted); display:block; margin-bottom:4px; }
.f-box .f-value{ font-size:calc(1.3rem * var(--custom-font-scale)); font-weight:800; color:var(--heading-color); }
.f-op{ font-size:1.7rem; font-weight:900; color:var(--gold); }
@media (max-width:1100px){ .formula-pipeline{ grid-template-columns:1fr; } .f-op{ display:none; } }

/* ============ FLIP CARDS ============ */
.flip-card-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:12px; width:100%; max-width:1340px; margin:8px auto; }
@media (max-width:1100px){ .flip-card-grid{ grid-template-columns:repeat(2,1fr); } }
.flip-card{ background:var(--card-bg); border:1.5px solid var(--card-border); border-radius:16px; padding:10px; cursor:pointer; perspective:1000px; height:120px; position:relative; transition:all .3s cubic-bezier(.34,1.56,.64,1); }
.flip-card:hover{ transform:translateY(-4px); border-color:var(--highlight-border); }
.flip-card-inner{ position:relative; width:100%; height:100%; transition:transform .6s ease; transform-style:preserve-3d; }
.flip-card.flipped .flip-card-inner{ transform:rotateY(180deg); }
.flip-card-front,.flip-card-back{ position:absolute; inset:0; backface-visibility:hidden; display:flex; flex-direction:column; align-items:center; justify-content:center; border-radius:12px; padding:6px; }
.flip-card-back{ transform:rotateY(180deg); background:var(--highlight-bg); color:var(--highlight-text); font-weight:800; font-size:calc(.95em * var(--custom-font-scale)); }
.flip-card.known{ border-color:var(--ok); box-shadow:0 0 0 2px var(--ok) inset; }
.fc-marks{ position:absolute; bottom:4px; right:6px; display:flex; gap:4px; z-index:5; }
.fc-mark{ border:none; cursor:pointer; border-radius:6px; padding:2px 6px; font-size:.7rem; font-weight:800; background:var(--highlight-bg); color:var(--highlight-text); }

/* ============ QUIZ + FILL-IN-THE-BLANK ============ */
.quiz-container{
  background:var(--card-bg); border:1px solid var(--card-border); border-radius:18px;
  padding:14px 22px; margin:6px auto; width:100%; max-width:1340px; text-align:left;
}
.quiz-progress-bar{ height:8px; width:100%; background:var(--highlight-bg); border-radius:4px; margin-bottom:12px; overflow:hidden; }
.quiz-progress-fill{ height:100%; width:0%; background:linear-gradient(90deg,var(--heading-color),var(--green)); border-radius:4px; transition:width .4s ease; }
.question-row{ padding:9px 0; border-bottom:1px dashed var(--card-border); }
.question-row:last-of-type{ border-bottom:none; }
.q-text{ font-size:calc(1.05rem * var(--custom-font-scale)); font-weight:600; margin-bottom:7px; }
.q-tag{ display:inline-block; font-size:.7rem; font-weight:800; padding:2px 8px; border-radius:6px; background:var(--gold); color:#fff; margin-right:8px; vertical-align:middle; }
.options{ display:flex; gap:8px; flex-wrap:wrap; }
.option-btn{
  font-family:inherit; font-size:calc(.98rem * var(--custom-font-scale)); font-weight:700; cursor:pointer;
  padding:8px 16px; border-radius:10px; background:var(--highlight-bg);
  color:var(--text-main); border:1.5px solid var(--card-border); transition:all .18s ease;
}
.option-btn:hover:not(:disabled){ border-color:var(--highlight-border); transform:translateY(-1px); }
.option-btn:disabled{ cursor:default; }
.option-btn.correct{ background:var(--ok); color:#fff; border-color:var(--ok); }
.option-btn.wrong{ background:var(--err); color:#fff; border-color:var(--err); }
.score-display{ font-weight:800; color:var(--heading-color); font-size:1.02rem; }
.retry-btn{
  font-family:inherit; font-weight:700; cursor:pointer; padding:8px 16px; border-radius:10px;
  background:var(--gold); color:#fff; border:none; font-size:.9rem;
}

/* Fill-in-the-blank */
.fib-input{
  font-family:inherit; font-size:calc(1.02rem * var(--custom-font-scale)); font-weight:700;
  padding:6px 12px; border-radius:9px; min-width:170px;
  background:var(--card-bg); color:var(--text-main);
  border:2px solid var(--card-border); transition:all .18s ease;
}
.fib-input:focus{ outline:none; border-color:var(--highlight-border); }
.fib-input.correct{ border-color:var(--ok); background:rgba(4,120,87,.10); }
.fib-input.wrong{ border-color:var(--err); background:rgba(220,38,38,.10); }
.fib-verdict{ margin-left:9px; font-weight:800; font-size:1rem; }
.fib-verdict.ok{ color:var(--ok); }
.fib-verdict.no{ color:var(--err); }
.accent-bar{ display:flex; gap:5px; flex-wrap:wrap; margin:10px 0 4px; align-items:center; }
.accent-bar .ab-label{ font-size:.75rem; font-weight:700; color:var(--text-muted); margin-right:4px; }
.accent-key{
  font-family:inherit; cursor:pointer; border-radius:7px; padding:4px 10px;
  background:var(--highlight-bg); color:var(--highlight-text);
  border:1px solid var(--card-border); font-size:1rem; font-weight:700;
}
.accent-key:hover{ border-color:var(--highlight-border); }
.fib-actions{ display:flex; gap:8px; align-items:center; margin-top:10px; flex-wrap:wrap; }

/* ============ TEACHER / STUDENT MODE ============ */
/* In teacher mode the interactive widgets stay covered so the class answers aloud first. */
body.mode-teacher .student-only{ display:none !important; }
body.mode-student .teacher-only{ display:none !important; }
.mode-veil{
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px;
  padding:22px; border:2px dashed var(--card-border); border-radius:16px;
  background:var(--highlight-bg); text-align:center; width:100%; max-width:1340px; margin:8px auto;
}
.mode-veil p{ color:var(--text-muted); margin:0; }

/* ============ HUD ============ */
.hud{
  position:fixed; left:0; right:0; bottom:0; height:var(--hud-h); z-index:40;
  display:flex; align-items:center; justify-content:center; gap:12px; padding:0 14px;
  background:var(--hud-bg); backdrop-filter:blur(10px); border-top:1px solid var(--card-border);
}
.nav-btn{
  font-family:inherit; font-size:.9rem; font-weight:700; cursor:pointer;
  padding:9px 18px; border-radius:10px; background:var(--highlight-bg);
  color:var(--hud-text); border:1px solid var(--card-border); transition:all .18s ease;
}
.nav-btn:hover:not(:disabled){ background:var(--highlight-border); color:#fff; }
.nav-btn:disabled{ opacity:.35; cursor:not-allowed; }
.slide-counter{ font-weight:800; color:var(--hud-text); font-size:.9rem; min-width:340px; text-align:center; }
.topic-progress{ position:fixed; bottom:var(--hud-h); left:0; height:3px; background:var(--highlight-border); z-index:41; transition:width .3s ease; }

/* ============ PANELS / MODALS ============ */
.settings-panel, .shortcuts-modal, .search-modal{
  position:fixed; background:var(--card-bg); border:1px solid var(--card-border);
  border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,.35); z-index:60;
  opacity:0; visibility:hidden; transform:translateY(-10px); transition:all .22s ease;
}
.settings-panel{ top:calc(var(--topbar-h) + 8px); right:12px; width:330px; max-height:78vh; overflow-y:auto; padding:16px; }
.shortcuts-modal{ top:calc(var(--topbar-h) + 8px); right:12px; width:320px; padding:16px; }
.settings-panel.open, .shortcuts-modal.open, .search-modal.open{ opacity:1; visibility:visible; transform:translateY(0); }
.settings-group{ margin-bottom:14px; }
.settings-group label{ display:block; font-size:.78rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); margin-bottom:6px; }
.settings-group select{
  width:100%; padding:8px 10px; border-radius:9px; font-family:inherit; font-size:.88rem;
  background:var(--card-bg); color:var(--text-main); border:1px solid var(--card-border);
}
.settings-panel button{
  font-family:inherit; cursor:pointer; border-radius:9px; padding:8px 12px;
  font-size:.84rem; font-weight:700; border:1px solid var(--card-border);
  background:var(--highlight-bg); color:var(--text-main); margin:2px 2px 0 0;
}
.settings-panel button:hover{ border-color:var(--highlight-border); }
.save-edits-btn{ width:100%; background:var(--green) !important; color:#fff !important; border:none !important; margin-bottom:12px !important; }
.reset-btn{ width:100%; background:var(--crimson) !important; color:#fff !important; border:none !important; }
.check-row{ display:flex; align-items:center; gap:8px; font-size:.88rem; font-weight:600; }
.shortcuts-modal ul{ list-style:none; padding:0; margin:0; }
.shortcuts-modal li{ display:flex; justify-content:space-between; gap:10px; padding:5px 0; font-size:.84rem; border-bottom:1px solid var(--card-border); }
kbd{ background:var(--highlight-bg); border:1px solid var(--card-border); border-radius:5px; padding:1px 7px; font-family:inherit; font-size:.8rem; font-weight:800; }

/* Search */
.search-modal{ top:14vh; left:50%; margin-left:-320px; width:640px; max-height:66vh; display:flex; flex-direction:column; padding:14px; }
.search-modal input{
  width:100%; padding:12px 14px; border-radius:11px; font-family:inherit; font-size:1.02rem; font-weight:600;
  background:var(--card-bg); color:var(--text-main); border:2px solid var(--highlight-border); margin-bottom:10px;
}
.search-modal input:focus{ outline:none; }
.search-results{ overflow-y:auto; }
.search-hit{
  display:block; width:100%; text-align:left; cursor:pointer; padding:9px 12px; border-radius:9px;
  background:transparent; border:none; color:var(--text-main); font-family:inherit; font-size:.9rem;
}
.search-hit:hover, .search-hit.sel{ background:var(--highlight-bg); }
.search-hit .sh-path{ display:block; font-size:.74rem; color:var(--text-muted); font-weight:700; }
.search-empty{ padding:14px; color:var(--text-muted); font-size:.88rem; text-align:center; }

/* Toast */
#toastNotification{
  position:fixed; bottom:calc(var(--hud-h) + 16px); left:50%; transform:translateX(-50%) translateY(20px);
  background:var(--green); color:#fff; padding:11px 22px; border-radius:11px; font-weight:700; font-size:.9rem;
  z-index:70; opacity:0; visibility:hidden; transition:all .3s ease; box-shadow:0 10px 30px rgba(0,0,0,.3);
}
#toastNotification.show{ opacity:1; visibility:visible; transform:translateX(-50%) translateY(0); }

/* Live edit */
body.editing-active [contenteditable="true"]{ outline:2px dashed var(--gold); outline-offset:3px; border-radius:5px; }

/* ============ RESPONSIVE ============ */
@media (max-width:1024px){
  body:not(.sidebar-forced) .sidebar{ transform:translateX(100%); }
  body:not(.sidebar-forced) .reveal-shell{ right:0; }
  .slide-card{ padding:18px 20px 14px; }
  .slide-counter{ min-width:auto; font-size:.8rem; }
}

/* ============ REDUCED MOTION ============ */
@media (prefers-reduced-motion: reduce){
  *{ animation-duration:.01ms !important; transition-duration:.01ms !important; }
  canvas.fx-layer{ display:none; }
}

/* ============ PRINT / A4 WORKSHEET EXPORT ============ */
@page{ size:A4; margin:12mm 12mm 14mm 12mm; }
@media print{
  .topbar, .sidebar, .hud, .settings-panel, .shortcuts-modal, .search-modal,
  .pick-modal, canvas.fx-layer, #toastNotification, .topic-progress, .accent-bar,
  .fib-actions, .retry-btn, .fc-marks, .audio-btn, .tl-controls, .step-hint{ display:none !important; }
  html, body{ width:auto; height:auto; overflow:visible; background:#fff !important; }
  body{ color:#000 !important; font-size:10.5pt; }
  .reveal-shell{ position:static !important; inset:auto !important; }
  .reveal, .reveal .slides{ position:static !important; width:auto !important; height:auto !important; transform:none !important; }
  .reveal .slides section{ display:block !important; position:static !important; transform:none !important; opacity:1 !important; visibility:visible !important; height:auto !important; }
  .slide-card{
    height:auto !important; max-width:100% !important; width:100% !important; overflow:visible !important;
    box-shadow:none !important; border:1px solid #bbb !important; background:#fff !important;
    padding:8mm 6mm !important; margin:0 0 6mm !important; border-radius:6px !important;
    page-break-inside:avoid; break-inside:avoid;
  }
  /* Every fragment and both card faces print revealed — a worksheet must show answers */
  .reveal .fragment{ opacity:1 !important; visibility:visible !important; transform:none !important; }
  .flip-card{ height:auto !important; }
  .flip-card-inner{ transform:none !important; }
  .flip-card-front, .flip-card-back{ position:static !important; transform:none !important; backface-visibility:visible !important; }
  .mode-veil{ display:none !important; }
  .student-only, .teacher-only{ display:block !important; }
  /* Denser A4 typography */
  h1{ font-size:18pt !important; } h2{ font-size:14pt !important; } h3{ font-size:12pt !important; }
  p, .subj-table td, .subj-table th, .q-text{ font-size:10.5pt !important; line-height:1.35 !important; }
  .two-columns{ grid-template-columns:1fr 1fr !important; gap:5mm !important; }
  .three-columns{ grid-template-columns:1fr 1fr 1fr !important; gap:4mm !important; }
  .box{ padding:3mm 4mm !important; margin:2mm auto !important; }
  .fib-input{ border:none !important; border-bottom:1px solid #333 !important; border-radius:0 !important; min-width:120px; background:transparent !important; }
  /* Clean page break between each sub-topic stack and between topics */
  body.printing-book .reveal .slides > section{ page-break-after:always; break-after:page; }
  body.printing-book .reveal .slides > section:last-child{ page-break-after:auto; }
}
/* Single-topic export: only the tagged topic prints */
body.printing-topic .reveal .slides > section:not(.print-target){ display:none !important; }
body.printing-topic .reveal .slides > section.print-target,
body.printing-topic .reveal .slides > section.print-target > section{
  display:block !important; position:static !important; transform:none !important;
  opacity:1 !important; visibility:visible !important; height:auto !important;
}
body.printing-topic .reveal .slides > section.print-target{ page-break-after:auto; }
body.printing-topic .reveal .slides > section.print-target > section{ page-break-inside:avoid; break-inside:avoid; }

/* ============ PICK-A-STUDENT MODAL ============ */
.pick-modal{
  position:fixed; inset:0; z-index:80; display:flex; align-items:center; justify-content:center;
  background:rgba(2,6,23,.62); backdrop-filter:blur(4px);
  opacity:0; visibility:hidden; transition:opacity .22s ease;
}
.pick-modal.open{ opacity:1; visibility:visible; }
.pick-card{
  position:relative; width:min(560px,92vw); background:var(--card-bg); color:var(--text-main);
  border:1px solid var(--card-border); border-radius:22px; padding:30px 26px 26px;
  box-shadow:0 30px 80px rgba(0,0,0,.45); text-align:center; transform:translateY(10px) scale(.97);
  transition:transform .25s cubic-bezier(.34,1.56,.64,1);
}
.pick-modal.open .pick-card{ transform:translateY(0) scale(1); }
.pick-close{
  position:absolute; top:12px; right:14px; border:none; background:transparent; cursor:pointer;
  font-size:1.2rem; color:var(--text-muted);
}
.pick-title{ font-family:var(--custom-heading-font); font-size:1.6rem; margin:0 0 18px; color:var(--heading-color); }
.pick-class-row{ display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
.pick-class-btn{
  font-family:inherit; cursor:pointer; font-size:1.15rem; font-weight:800; padding:22px 30px;
  border-radius:16px; border:2px solid var(--highlight-border); background:var(--highlight-bg);
  color:var(--highlight-text); transition:all .18s ease; min-width:180px;
}
.pick-class-btn:hover{ transform:translateY(-3px); background:var(--highlight-border); color:#fff; }
.pick-stage{ display:flex; flex-direction:column; align-items:center; gap:14px; }
.pick-stage[hidden]{ display:none !important; }   /* attribute must beat display:flex */
.pick-name{
  font-family:var(--custom-heading-font); font-weight:900; line-height:1.1;
  font-size:clamp(1.8rem, 6vw, 3rem); color:var(--heading-color);
  padding:18px 22px; border-radius:18px; background:var(--highlight-bg);
  border:2px dashed var(--highlight-border); min-width:280px; word-break:break-word;
}
.pick-name.spinning{ animation:pickPulse .12s linear infinite; opacity:.85; }
.pick-name.landed{ animation:pickLand .5s cubic-bezier(.34,1.8,.5,1); border-style:solid; box-shadow:0 0 0 4px var(--highlight-bg); }
@keyframes pickPulse{ 0%{ transform:scale(.98); } 50%{ transform:scale(1.02); } 100%{ transform:scale(.98); } }
@keyframes pickLand{ 0%{ transform:scale(.6) rotate(-4deg); } 60%{ transform:scale(1.12) rotate(2deg); } 100%{ transform:scale(1) rotate(0); } }
.pick-sub{ font-size:.9rem; color:var(--text-muted); font-weight:700; }
.pick-actions{ display:flex; gap:10px; flex-wrap:wrap; justify-content:center; margin-top:6px; }
.pick-again-btn, .pick-back-btn{
  font-family:inherit; cursor:pointer; font-weight:700; padding:10px 18px; border-radius:11px; font-size:.92rem; border:1px solid var(--card-border);
}
.pick-again-btn{ background:var(--gold); color:#fff; border:none; }
.pick-back-btn{ background:var(--highlight-bg); color:var(--text-main); }
.settings-panel .print-topic-btn, .settings-panel .print-book-btn{ width:100%; margin:2px 0 0; }

/* ============ AUDIO (Click-to-hear French) ============ */
.audio-btn{
  display:inline-flex; align-items:center; justify-content:center; cursor:pointer;
  border:1px solid var(--card-border); background:var(--highlight-bg); color:var(--highlight-text);
  border-radius:8px; width:1.7em; height:1.7em; font-size:.82em; margin-left:6px; vertical-align:middle;
  transition:all .15s ease; padding:0; line-height:1;
}
.audio-btn:hover{ background:var(--highlight-border); color:#fff; transform:scale(1.08); }
.audio-btn.speaking{ animation:pickPulse .5s ease infinite; background:var(--green); color:#fff; }

/* ============ PROJECTOR / FULLSCREEN MODE ============ */
body.projector-mode .topbar,
body.projector-mode .sidebar,
body.projector-mode .topic-progress{ display:none !important; }
body.projector-mode .reveal-shell{ top:0 !important; right:0 !important; bottom:var(--hud-h) !important; }
body.projector-mode{ --custom-font-scale:1.18; }
body.projector-mode .slide-card{ padding:clamp(24px, 3.2vw, 54px) clamp(30px, 5vw, 90px); }
body.projector-mode h1{ font-size:clamp(2.4rem, 5.2vw, 4.6rem); }
body.projector-mode h2{ font-size:clamp(1.8rem, 3.6vw, 3.2rem); }
body.projector-mode h3{ font-size:clamp(1.3rem, 2.2vw, 2rem); }
body.projector-mode p, body.projector-mode .subj-table td, body.projector-mode .example-text{
  font-size:clamp(1.1rem, 1.7vw, 1.7rem);
}
body.projector-mode .hud{ opacity:.35; transition:opacity .2s ease; }
body.projector-mode .hud:hover{ opacity:1; }

/* ============ STEP-REVEAL HUD BUTTONS + HINT ============ */
.hud .step-group{ display:inline-flex; gap:6px; align-items:center; }
.step-hint{
  position:fixed; bottom:calc(var(--hud-h) + 10px); left:50%; transform:translateX(-50%);
  background:var(--hud-bg); color:var(--text-muted); border:1px solid var(--card-border);
  border-radius:999px; padding:4px 14px; font-size:.76rem; font-weight:700; z-index:39;
  opacity:0; visibility:hidden; transition:opacity .3s ease;
}
.step-hint.show{ opacity:1; visibility:visible; }

/* ============ INTERACTIVE TENSE TIMELINE (HERO) ============ */
.tl-hero{ width:100%; max-width:1500px; margin:0 auto; }
.tl-toolbar{ display:flex; gap:10px; align-items:center; justify-content:center; flex-wrap:wrap; margin-bottom:10px; }
.tl-verb-btn{
  font-family:inherit; cursor:pointer; font-weight:800; padding:7px 16px; border-radius:999px;
  border:1.5px solid var(--card-border); background:var(--highlight-bg); color:var(--highlight-text); font-size:.95rem;
}
.tl-verb-btn.is-on{ background:var(--highlight-border); color:#fff; }
/* Mood overlays float above the axis */
.tl-moods{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-bottom:6px; }
.tl-mood{
  padding:6px 16px; border-radius:12px; font-weight:800; font-size:.9rem; cursor:pointer;
  border:1.5px dashed; background:var(--card-bg);
}
.tl-mood.cond{ color:var(--purple); border-color:var(--purple); }
.tl-mood.subj{ color:var(--gold); border-color:var(--gold); }
.tl-mood.active{ color:#fff; }
.tl-mood.cond.active{ background:var(--purple); }
.tl-mood.subj.active{ background:var(--gold); }
/* The scrolling track of tense nodes */
.tl-track-wrap{ position:relative; overflow-x:auto; overflow-y:hidden; padding:26px 6px 14px; }
.tl-track-wrap::-webkit-scrollbar{ height:8px; }
.tl-track-wrap::-webkit-scrollbar-thumb{ background:var(--card-border); border-radius:4px; }
.tl-track{ position:relative; display:flex; gap:14px; min-width:min-content; align-items:stretch; padding-top:10px; }
.tl-axis{ position:absolute; left:10px; right:10px; top:20px; height:4px; border-radius:2px;
  background:linear-gradient(90deg, var(--heading-color), var(--green), var(--gold)); opacity:.55; }
.tl-node{
  position:relative; flex:0 0 auto; width:clamp(140px, 15vw, 190px);
  background:var(--card-bg); border:1.5px solid var(--card-border); border-radius:16px;
  padding:16px 12px 12px; cursor:pointer; transition:all .2s cubic-bezier(.34,1.56,.64,1); text-align:center;
}
.tl-node::before{ content:''; position:absolute; top:-16px; left:50%; transform:translateX(-50%);
  width:14px; height:14px; border-radius:50%; background:var(--heading-color); border:3px solid var(--card-bg); box-shadow:0 0 0 2px var(--heading-color); }
.tl-node:hover{ transform:translateY(-5px); border-color:var(--highlight-border); }
.tl-node.active{ border-color:var(--highlight-border); box-shadow:0 10px 30px rgba(0,0,0,.18); transform:translateY(-5px); }
.tl-node.past::before{ background:var(--purple); box-shadow:0 0 0 2px var(--purple); }
.tl-node.present::before{ background:var(--green); box-shadow:0 0 0 2px var(--green); }
.tl-node.future::before{ background:var(--gold); box-shadow:0 0 0 2px var(--gold); }
.tl-node .tl-fr{ font-family:var(--custom-heading-font); font-weight:800; font-size:1rem; color:var(--heading-color); line-height:1.15; }
.tl-node .tl-en{ font-size:.78rem; color:var(--text-muted); margin:2px 0 8px; }
.tl-node .tl-formula{ display:inline-block; font-size:.72rem; font-weight:800; padding:2px 8px; border-radius:6px; background:var(--highlight-bg); color:var(--highlight-text); margin-bottom:8px; }
.tl-node .tl-ex{ font-size:.86rem; font-style:italic; color:var(--text-main); line-height:1.25; }
.tl-arrow{ flex:0 0 auto; align-self:center; color:var(--gold); font-size:1.4rem; font-weight:900; padding-top:10px; }
/* Detail panel below the track */
.tl-detail{
  margin-top:14px; background:var(--box-blue-bg); border:1.5px solid var(--card-border);
  border-left:5px solid var(--heading-color); border-radius:14px; padding:16px 20px; text-align:left; min-height:96px;
}
.tl-detail h3{ margin:0 0 6px; }
.tl-detail .tl-d-ex{ font-style:italic; font-size:1.05rem; margin:4px 0; }
.tl-detail .gloss{ display:block; }
.tl-controls{ display:flex; gap:8px; align-items:center; margin-top:10px; flex-wrap:wrap; }
@media (max-width:820px){ .tl-node{ width:150px; } }

/* ============ CLUE-WORD MIXED PRACTICE (CBSE) ============ */
.clue{ display:inline-block; padding:1px 9px; border-radius:6px; background:var(--gold); color:#fff; font-weight:800; font-style:normal; }
.hint-btn{
  font-family:inherit; cursor:pointer; border:1px solid var(--card-border); background:var(--highlight-bg);
  color:var(--highlight-text); border-radius:8px; padding:2px 10px; font-size:.78rem; font-weight:700; margin-left:8px; vertical-align:middle;
}
.hint-btn:hover{ border-color:var(--highlight-border); }
.hint-box{ margin:6px 0 2px; padding:8px 12px; border-left:4px solid var(--gold); background:var(--box-gold-bg); border-radius:8px; font-size:.92rem; }
.hint-box[hidden]{ display:none; }
</style>
</head>
<body class="theme-slate mode-teacher">

<canvas class="fx-layer" id="ambientParticlesCanvas"></canvas>
<canvas class="fx-layer" id="fireworksCanvas"></canvas>
<canvas class="fx-layer" id="confettiCanvas"></canvas>
<div id="toastNotification">✅ Saved!</div>

<!-- ============ TOP BAR ============ -->
<header class="topbar">
  <span class="brand">🇫🇷 French Grammar — Class 10</span>

  <div class="topic-menu-wrap">
    <button class="tb-btn" id="topicMenuBtn" title="Choose a grammar topic">📚 Topics ▾</button>
    <div class="topic-menu" id="topicMenu"></div>
  </div>

  <button class="tb-btn" id="searchBtn" title="Search a rule (Ctrl+K)">🔍 Search</button>
  <button class="tb-btn" id="pickStudentBtn" title="Pick a random student">🎲 Pick Student</button>

  <span class="tb-spacer"></span>

  <button class="tb-btn" id="modeBtn" title="Switch Teacher / Student (T)">👩‍🏫 Teacher</button>
  <button class="tb-btn" id="lightBtn" title="Light / Dark (L)">🌙</button>
  <button class="tb-btn" id="soundBtn" title="Turn sound on">🔇</button>
  <button class="tb-btn" id="projectorBtn" title="Projector / Fullscreen mode (P)">📺</button>
  <button class="tb-btn" id="printBtn" title="Print this topic">🖨️</button>
  <button class="tb-btn" id="sidebarBtn" title="Show / hide the menu">📑</button>
  <button class="tb-btn" id="shortcutsBtn" title="Keyboard shortcuts (?)">⌨️</button>
  <button class="tb-btn" id="settingsBtn" title="Customization (S)">⚙️</button>
</header>

<!-- ============ SIDEBAR ============ -->
<aside class="sidebar" id="sidebar"></aside>

<!-- ============ SHORTCUTS ============ -->
<div class="shortcuts-modal" id="shortcutsModal">
  <h3 style="margin-top:0;">⌨️ Keyboard Shortcuts</h3>
  <ul>
    <li><span>Next / previous step (reveal)</span><span><kbd>→</kbd> / <kbd>Space</kbd></span></li>
    <li><span>Previous step</span><span><kbd>←</kbd></span></li>
    <li><span>Clicker keys also work</span><span><kbd>PgDn</kbd> / <kbd>PgUp</kbd></span></li>
    <li><span>Search</span><span><kbd>Ctrl</kbd>+<kbd>K</kbd></span></li>
    <li><span>Teacher / Student</span><span><kbd>T</kbd></span></li>
    <li><span>Light / Dark</span><span><kbd>L</kbd></span></li>
    <li><span>Projector / Fullscreen</span><span><kbd>P</kbd> / <kbd>F</kbd></span></li>
    <li><span>Customization</span><span><kbd>S</kbd></span></li>
    <li><span>Live edit</span><span><kbd>E</kbd></span></li>
    <li><span>Slide overview</span><span><kbd>Esc</kbd></span></li>
  </ul>
</div>

<!-- ============ SETTINGS ============ -->
<div class="settings-panel" id="settingsPanel">
  <h3 style="margin-top:0;">⚙️ Customization</h3>

  <div class="settings-group">
    <label>Print</label>
    <button class="print-topic-btn" id="printTopicBtn2">🖨️ Print this topic (A4)</button>
    <button class="print-book-btn" id="printBookBtn">📚 Print complete workbook</button>
  </div>

  <div class="settings-group">
    <label>Live Edit</label>
    <div class="check-row">
      <input type="checkbox" id="liveEditToggle">
      <span>Edit slide text directly</span>
    </div>
  </div>

  <div class="settings-group">
    <label>Add an element</label>
    <button data-add="blue">➕ Blue Box</button>
    <button data-add="gold">➕ Gold Box</button>
    <button data-add="badge">➕ Badge</button>
    <button data-add="bullet">➕ Bullet</button>
  </div>

  <button class="save-edits-btn" id="saveEditsBtn">💾 Save text</button>

  <div class="settings-group">
    <label>Theme</label>
    <select id="themeSelect">
      <option value="theme-slate">🌑 Slate Night (default)</option>
      <option value="theme-cyber">🌌 Midnight Cyber Neon</option>
      <option value="theme-classic">🇫🇷 French Tricolor Classic</option>
      <option value="theme-sunrise">☀️ Warm Sunrise Gold</option>
      <option value="theme-emerald">🌲 Emerald Forest</option>
      <option value="theme-purple">🍇 Royal Purple</option>
      <option value="theme-minimal">🎨 Minimalist Clean Studio</option>
    </select>
  </div>

  <div class="settings-group">
    <label>Font</label>
    <select id="fontFamilySelect">
      <option value="'Plus Jakarta Sans', sans-serif">Plus Jakarta Sans</option>
      <option value="'Outfit', sans-serif">Outfit</option>
      <option value="'Poppins', sans-serif">Poppins</option>
      <option value="'Playfair Display', serif">Playfair Display</option>
      <option value="'Space Grotesk', sans-serif">Space Grotesk</option>
      <option value="'Comic Neue', cursive">Comic Neue</option>
      <option value="'Cinzel', serif">Cinzel</option>
    </select>
  </div>

  <div class="settings-group">
    <label>Text size</label>
    <select id="fontSizeSelect">
      <option value="0.88">88% — Compact</option>
      <option value="1" selected>100% — Normal</option>
      <option value="1.15">115% — Large</option>
      <option value="1.3">130% — Projector</option>
    </select>
  </div>

  <div class="settings-group">
    <label>Text colour</label>
    <select id="textColorSelect">
      <option value="">Default (theme)</option>
      <option value="#002395">French Navy</option>
      <option value="#ED2939">Crimson Red</option>
      <option value="#047857">Emerald Green</option>
      <option value="#7e22ce">Royal Purple</option>
      <option value="#0f172a">Slate Dark</option>
      <option value="#f8fafc">White</option>
    </select>
  </div>

  <button class="reset-btn" id="resetBtn">🔄 Reset everything</button>
</div>

<!-- ============ PICK-A-STUDENT MODAL ============ -->
<div class="pick-modal" id="pickStudentModal">
  <div class="pick-card">
    <button class="pick-close" id="pickCloseBtn" title="Close">✕</button>
    <h3 class="pick-title">🎲 Pick a Student</h3>
    <div class="pick-class-row" id="pickClassRow">
      <button class="pick-class-btn" data-class="10E">👥 Class 10&nbsp;E</button>
      <button class="pick-class-btn" data-class="10J">👥 Class 10&nbsp;J</button>
    </div>
    <div class="pick-stage" id="pickStage" hidden>
      <div class="pick-name" id="pickName">—</div>
      <div class="pick-sub" id="pickSub"></div>
      <div class="pick-actions">
        <button class="pick-again-btn" id="pickAgainBtn">🎲 Spin again</button>
        <button class="pick-back-btn" id="pickBackBtn">↩ Change class</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ SEARCH ============ -->
<div class="search-modal" id="searchModal">
  <input type="text" id="searchInput" placeholder="Search a rule, a word, an example… (e.g. dont, y en, passé composé)" autocomplete="off">
  <div class="search-results" id="searchResults"></div>
</div>

<!-- ============ PRESENTATION ============ -->
<div class="reveal-shell">
  <div class="reveal">
    <div class="slides" id="slidesRoot">
      <!-- ==================================================================
           HERO TOPIC 0 — INTERACTIVE TIMELINE OF FRENCH TENSES
           (inserted first; new data-topic, additive to the engine)
           =================================================================== -->
      <section data-topic="timeline" data-topic-name="Timeline of Tenses" data-sub="Interactive Timeline">

        <!-- SLIDE 1 — the interactive timeline -->
        <section data-slide-id="tl-hero-1" data-step="Interactive Timeline">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <h2 class="editable-field">🕐 The French Tenses on One Timeline</h2>
            <p class="editable-field" style="margin-bottom:6px;">Pick a verb, then click any tense to see how it works. Past → Present → Future, left to right. <strong>Conditional</strong> and <strong>Subjunctive</strong> are moods, shown above.</p>

            <div class="tl-hero" data-tl='{
              "manger": {
                "pqp":{"fr":"Plus-que-parfait","en":"had eaten","formula":"avais + mangé","ex":"J&#39;avais mangé","gloss":"I had eaten (before another past action)"},
                "pc":{"fr":"Passé Composé","en":"ate / have eaten","formula":"ai + mangé","ex":"J&#39;ai mangé","gloss":"I ate / I have eaten (a finished action)"},
                "imp":{"fr":"Imparfait","en":"was eating / used to eat","formula":"radical + -ais","ex":"Je mangeais","gloss":"I was eating / I used to eat (background, habit)"},
                "passeRecent":{"fr":"Passé Récent","en":"have just eaten","formula":"venir de + manger","ex":"Je viens de manger","gloss":"I have just eaten (a moment ago)"},
                "present":{"fr":"Présent","en":"eat / am eating","formula":"radical + -e","ex":"Je mange","gloss":"I eat / I am eating (now, habit, general truth)"},
                "futurProche":{"fr":"Futur Proche","en":"am going to eat","formula":"vais + manger","ex":"Je vais manger","gloss":"I am going to eat (soon, already decided)"},
                "futurSimple":{"fr":"Futur Simple","en":"will eat","formula":"manger + -ai","ex":"Je mangerai","gloss":"I will eat (later, a plan or prediction)"},
                "futurAnterieur":{"fr":"Futur Antérieur","en":"will have eaten","formula":"aurai + mangé","ex":"J&#39;aurai mangé","gloss":"I will have eaten (finished before another future action)"},
                "conditionnel":{"fr":"Conditionnel","en":"would eat","formula":"manger + -ais","ex":"Je mangerais","gloss":"I would eat (a wish, a hypothesis, politeness)"},
                "subjonctif":{"fr":"Subjonctif","en":"(that) I eat","formula":"que + subjonctif","ex":"que je mange","gloss":"…that I eat (after il faut que, vouloir que, bien que)"}
              },
              "partir": {
                "pqp":{"fr":"Plus-que-parfait","en":"had left","formula":"étais + parti(e)","ex":"J&#39;étais parti(e)","gloss":"I had left (before another past action)"},
                "pc":{"fr":"Passé Composé","en":"left / have left","formula":"suis + parti(e)","ex":"Je suis parti(e)","gloss":"I left / I have left — partir takes être"},
                "imp":{"fr":"Imparfait","en":"was leaving / used to leave","formula":"radical + -ais","ex":"Je partais","gloss":"I was leaving / I used to leave (background, habit)"},
                "passeRecent":{"fr":"Passé Récent","en":"have just left","formula":"venir de + partir","ex":"Je viens de partir","gloss":"I have just left (a moment ago)"},
                "present":{"fr":"Présent","en":"leave / am leaving","formula":"irregular -s","ex":"Je pars","gloss":"I leave / I am leaving (now, habit)"},
                "futurProche":{"fr":"Futur Proche","en":"am going to leave","formula":"vais + partir","ex":"Je vais partir","gloss":"I am going to leave (soon, already decided)"},
                "futurSimple":{"fr":"Futur Simple","en":"will leave","formula":"partir + -ai","ex":"Je partirai","gloss":"I will leave (later, a plan or prediction)"},
                "futurAnterieur":{"fr":"Futur Antérieur","en":"will have left","formula":"serai + parti(e)","ex":"Je serai parti(e)","gloss":"I will have left (finished before another future action)"},
                "conditionnel":{"fr":"Conditionnel","en":"would leave","formula":"partir + -ais","ex":"Je partirais","gloss":"I would leave (a wish, a hypothesis, politeness)"},
                "subjonctif":{"fr":"Subjonctif","en":"(that) I leave","formula":"que + subjonctif","ex":"que je parte","gloss":"…that I leave (after il faut que, vouloir que, bien que)"}
              }
            }'>
              <div class="tl-toolbar">
                <span style="font-weight:700; color:var(--text-muted); font-size:.9rem;">Sample verb:</span>
                <button class="tl-verb-btn is-on" data-verb="manger">manger (to eat)</button>
                <button class="tl-verb-btn" data-verb="partir">partir (to leave)</button>
              </div>

              <div class="tl-moods">
                <button class="tl-mood cond" data-tense="conditionnel">☁️ Conditionnel — "would"</button>
                <button class="tl-mood subj" data-tense="subjonctif">✨ Subjonctif — "(that) I…"</button>
              </div>

              <div class="tl-track-wrap">
                <div class="tl-axis"></div>
                <div class="tl-track">
                  <div class="tl-node past" data-tense="pqp">
                    <div class="tl-fr">Plus-que-parfait</div><div class="tl-en">had done</div>
                    <span class="tl-formula">—</span><div class="tl-ex">—</div>
                  </div>
                  <span class="tl-arrow">➔</span>
                  <div class="tl-node past" data-tense="pc">
                    <div class="tl-fr">Passé Composé</div><div class="tl-en">did / have done</div>
                    <span class="tl-formula">—</span><div class="tl-ex">—</div>
                  </div>
                  <div class="tl-node past" data-tense="imp">
                    <div class="tl-fr">Imparfait</div><div class="tl-en">was doing / used to</div>
                    <span class="tl-formula">—</span><div class="tl-ex">—</div>
                  </div>
                  <span class="tl-arrow">➔</span>
                  <div class="tl-node past" data-tense="passeRecent">
                    <div class="tl-fr">Passé Récent</div><div class="tl-en">have just done</div>
                    <span class="tl-formula">—</span><div class="tl-ex">—</div>
                  </div>
                  <span class="tl-arrow">➔</span>
                  <div class="tl-node present" data-tense="present">
                    <div class="tl-fr">Présent</div><div class="tl-en">do / am doing</div>
                    <span class="tl-formula">—</span><div class="tl-ex">—</div>
                  </div>
                  <span class="tl-arrow">➔</span>
                  <div class="tl-node future" data-tense="futurProche">
                    <div class="tl-fr">Futur Proche</div><div class="tl-en">am going to do</div>
                    <span class="tl-formula">—</span><div class="tl-ex">—</div>
                  </div>
                  <span class="tl-arrow">➔</span>
                  <div class="tl-node future" data-tense="futurSimple">
                    <div class="tl-fr">Futur Simple</div><div class="tl-en">will do</div>
                    <span class="tl-formula">—</span><div class="tl-ex">—</div>
                  </div>
                  <span class="tl-arrow">➔</span>
                  <div class="tl-node future" data-tense="futurAnterieur">
                    <div class="tl-fr">Futur Antérieur</div><div class="tl-en">will have done</div>
                    <span class="tl-formula">—</span><div class="tl-ex">—</div>
                  </div>
                </div>
              </div>

              <div class="tl-detail">
                <h3>Click a tense above 👆</h3>
                <p class="gloss">Each card shows the formation formula and a sample sentence. Use the 🔊 button to hear the French.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- SLIDE 2 — always-works at-a-glance summary (offline-safe fallback + revision) -->
        <section data-slide-id="tl-hero-2" data-step="Past · Present · Future">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <h2 class="editable-field">⏳ Past · Present · Future — at a glance</h2>
            <p class="editable-field gloss">The same nine tenses, grouped by time. This is your quick revision map.</p>
            <div class="three-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">⏪ THE PAST</h3>
                <p><span class="highlight hl-pronoun">Plus-que-parfait</span><br><span class="gloss">j'avais mangé — I had eaten</span></p>
                <p><span class="highlight hl-aux">Imparfait</span><br><span class="gloss">je mangeais — I was eating / used to</span></p>
                <p><span class="highlight hl-verb">Passé Composé</span><br><span class="gloss">j'ai mangé — I ate / have eaten</span></p>
                <p><span class="highlight hl-verb">Passé Récent</span><br><span class="gloss">je viens de manger — I have just eaten</span></p>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">⏺ THE PRESENT</h3>
                <p><span class="highlight hl-verb">Présent</span><br><span class="gloss">je mange — I eat / am eating</span></p>
                <p style="margin-top:14px;"><span class="highlight hl-pronoun">Conditionnel</span> <span class="gloss">(mood)</span><br><span class="gloss">je mangerais — I would eat</span></p>
                <p><span class="highlight hl-gold" style="background:rgba(217,119,6,.16); color:var(--gold); border:1px solid var(--gold); padding:2px 9px; border-radius:7px; font-weight:800;">Subjonctif</span> <span class="gloss">(mood)</span><br><span class="gloss">que je mange — (that) I eat</span></p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">⏩ THE FUTURE</h3>
                <p><span class="highlight hl-subject">Futur Proche</span><br><span class="gloss">je vais manger — I am going to eat</span></p>
                <p><span class="highlight hl-subject">Futur Simple</span><br><span class="gloss">je mangerai — I will eat</span></p>
                <p><span class="highlight hl-subject">Futur Antérieur</span><br><span class="gloss">j'aurai mangé — I will have eaten</span></p>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field">🔑 <strong>The one pattern that unlocks four tenses:</strong> the compound tenses are just
                <span class="highlight hl-aux">auxiliary (être/avoir)</span> + <span class="highlight hl-verb">past participle</span>.
                Change only the auxiliary's tense: présent → Passé Composé · imparfait → Plus-que-parfait · futur → Futur Antérieur.</p>
            </div>
            <p class="editable-field gloss">➡️ Press <kbd>→</kbd> to begin with <strong>Les Verbes</strong>, or open <strong>📚 Topics</strong> to jump anywhere.</p>
          </div>
        </section>
      </section>
      <!-- ==================================================================
           TOPIC 1 — LES VERBES : opener
           =================================================================== -->
      <section data-topic="verbes" data-topic-name="Les Verbes" data-sub="Vue d'ensemble">

        <section data-slide-id="verbes-intro-1" data-step="Bienvenue">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <svg class="svg-badge" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
              <circle cx="50" cy="50" r="45" fill="#002395" stroke="#ED2939" stroke-width="4"/>
              <path d="M30 45 L50 25 L70 45 L50 75 Z" fill="#ffffff"/>
            </svg>
            <h1 class="editable-field">🇫🇷 Les Verbes — Tous les Temps</h1>
            <h3 class="editable-field" style="color:var(--subheading-color);">CBSE Classe 10 · Section C · La question obligatoire</h3>
            <div class="box gold content-box">
              <p class="editable-field" style="font-weight:800; color:var(--heading-color);">Why start here?</p>
              <p class="editable-field">Verbs are the <strong>only compulsory question</strong> in the CBSE grammar section. Every other topic — negation, pronouns, reported speech — still needs a correctly conjugated verb. Master this and you protect marks everywhere.</p>
              <div style="display:flex; gap:7px; justify-content:center; flex-wrap:wrap; margin-top:8px;">
                <span class="highlight hl-verb">Présent</span>
                <span class="highlight hl-verb">Impératif</span>
                <span class="highlight hl-aux">Imparfait</span>
                <span class="highlight hl-aux">Passé Composé</span>
                <span class="highlight hl-aux">Plus-que-parfait</span>
                <span class="highlight hl-subject">Futur Simple</span>
                <span class="highlight hl-subject">Futur Antérieur</span>
                <span class="highlight hl-pronoun">Conditionnel</span>
                <span class="highlight hl-pronoun">Pronominaux</span>
              </div>
            </div>
            <p class="editable-field" style="color:var(--text-muted);">👉 <kbd>→</kbd> next rule · <kbd>↓</kbd> the 8 steps of a rule · <kbd>Ctrl</kbd>+<kbd>K</kbd> to search</p>
          </div>
        </section>

        <section data-slide-id="verbes-intro-2" data-step="Les 8 étapes">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <h2 class="editable-field">How every rule is taught here</h2>
            <p class="editable-field">Each tense below follows the <strong>same 8 steps</strong>, so you always know what comes next.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Understand</h3>
                <p><span class="highlight hl-subject">1. Description</span> — what it is, when to use it</p>
                <p><span class="highlight hl-subject">2. Formation</span> — the formula</p>
                <p><span class="highlight hl-neg">3. Exceptions</span> — irregulars</p>
                <p><span class="highlight hl-neg">4. Traps</span> — what students get wrong</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Apply</h3>
                <p><span class="highlight hl-verb">5. Examples</span> — worked, colour-coded</p>
                <p><span class="highlight hl-verb">6. In context</span> — Entre Jeunes themes</p>
                <p><span class="highlight hl-aux">7. Practice</span> — multiple choice</p>
                <p><span class="highlight hl-aux">8. Practice</span> — fill in the blank</p>
              </div>
            </div>
            <div class="box green content-box">
              <p class="editable-field"><strong>Colour code, used everywhere:</strong>
                <span class="highlight hl-subject">sujet</span>
                <span class="highlight hl-neg">négation</span>
                <span class="highlight hl-verb">verbe / terminaison</span>
                <span class="highlight hl-aux">auxiliaire / déclencheur</span>
                <span class="highlight hl-pronoun">pronom</span>
              </p>
            </div>
          </div>
        </section>

        <section data-slide-id="verbes-intro-3" data-step="Les 3 groupes">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <h2 class="editable-field">First: find the group — it decides every ending</h2>
            <p class="editable-field">Before conjugating anything, ask: <strong>which group is this verb in?</strong></p>
            <div class="three-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">1<sup>er</sup> groupe — <span class="key-form">-ER</span></h3>
                <p>The biggest group. Regular.</p>
                <p class="example-text">parler, aimer, regarder, manger, habiter</p>
                <p><span class="highlight hl-neg">Exception :</span> <strong>aller</strong> looks -er but is irregular.</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">2<sup>e</sup> groupe — <span class="key-form">-IR</span></h3>
                <p>Adds <strong>-iss-</strong> in the plural.</p>
                <p class="example-text">finir, choisir, réussir, grandir</p>
                <p class="gloss">nous fin<strong>iss</strong>ons — the giveaway</p>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">3<sup>e</sup> groupe — irréguliers</h3>
                <p>-RE, -OIR, and -IR without -iss-.</p>
                <p class="example-text">vendre, prendre, partir, vouloir, pouvoir</p>
                <p class="gloss">These must be memorised.</p>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field">⚠️ <strong>The test that catches everyone:</strong> <em>finir</em> and <em>partir</em> both end in -ir, but
                <span class="highlight hl-verb">nous finissons</span> (2<sup>e</sup>) vs <span class="highlight hl-neg">nous partons</span> (3<sup>e</sup>).
                Always check the <strong>nous</strong> form.</p>
            </div>
          </div>
        </section>
      </section>

      <!-- ==================================================================
           SUB-TOPIC 1.1 — LE PRÉSENT  (8 steps)
           =================================================================== -->
      <section data-topic="verbes" data-topic-name="Les Verbes" data-sub="Le Présent">

        <!-- 1 · DESCRIPTION -->
        <section data-slide-id="present-1" data-step="Description">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">1</span> Description</div>
            <h2 class="editable-field">Le Présent — what it is</h2>
            <p class="editable-field">The présent describes what is <strong>true now</strong>. French uses one present tense where English has three ("I speak / I am speaking / I do speak").</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Use it for…</h3>
                <p>① <strong>Right now</strong> — <span class="example-text">Je <span class="highlight hl-verb">mange</span> une pomme.</span> <span class="gloss">I am eating an apple.</span></p>
                <p>② <strong>Habits</strong> — <span class="example-text">Elle <span class="highlight hl-verb">va</span> au lycée tous les jours.</span> <span class="gloss">She goes to school every day.</span></p>
                <p>③ <strong>General truths</strong> — <span class="example-text">L'eau <span class="highlight hl-verb">bout</span> à 100 degrés.</span> <span class="gloss">Water boils at 100 degrees.</span></p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Also useful for…</h3>
                <p>④ <strong>Near future</strong> with a time marker — <span class="example-text">Je <span class="highlight hl-verb">pars</span> demain.</span> <span class="gloss">I'm leaving tomorrow.</span></p>
                <p>⑤ <strong>Since / for</strong> with <em>depuis</em> — <span class="example-text">J'<span class="highlight hl-verb">habite</span> ici <span class="highlight hl-aux">depuis</span> deux ans.</span> <span class="gloss">I have lived here for two years.</span></p>
                <p class="gloss">Note ⑤: English uses the perfect, French uses the <strong>présent</strong>. This is a common exam trap.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 2 · FORMATION -->
        <section data-slide-id="present-2" data-step="Formation">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">2</span> Formation</div>
            <h2 class="editable-field">La formule — radical + terminaison</h2>
            <div class="formula-pipeline">
              <div class="f-box"><span class="f-label">Infinitif</span><span class="f-value">parler</span></div>
              <div class="f-op">→</div>
              <div class="f-box"><span class="f-label">Radical (drop -er/-ir/-re)</span><span class="f-value">parl-</span></div>
              <div class="f-op">+</div>
              <div class="f-box"><span class="f-label">Terminaison</span><span class="f-value">-e -es -e -ons -ez -ent</span></div>
            </div>
            <div class="three-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">-ER — parler</h3>
                <table class="subj-table">
                  <tr><td>je</td><td class="key-form">parle</td></tr>
                  <tr><td>tu</td><td class="key-form">parles</td></tr>
                  <tr><td>il/elle</td><td class="key-form">parle</td></tr>
                  <tr><td>nous</td><td class="key-form">parlons</td></tr>
                  <tr><td>vous</td><td class="key-form">parlez</td></tr>
                  <tr><td>ils/elles</td><td class="key-form">parlent</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">-IR — finir</h3>
                <table class="subj-table">
                  <tr><td>je</td><td class="key-form">finis</td></tr>
                  <tr><td>tu</td><td class="key-form">finis</td></tr>
                  <tr><td>il/elle</td><td class="key-form">finit</td></tr>
                  <tr><td>nous</td><td class="key-form">finissons</td></tr>
                  <tr><td>vous</td><td class="key-form">finissez</td></tr>
                  <tr><td>ils/elles</td><td class="key-form">finissent</td></tr>
                </table>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">-RE — vendre</h3>
                <table class="subj-table">
                  <tr><td>je</td><td class="key-form">vends</td></tr>
                  <tr><td>tu</td><td class="key-form">vends</td></tr>
                  <tr><td>il/elle</td><td class="key-form">vend</td></tr>
                  <tr><td>nous</td><td class="key-form">vendons</td></tr>
                  <tr><td>vous</td><td class="key-form">vendez</td></tr>
                  <tr><td>ils/elles</td><td class="key-form">vendent</td></tr>
                </table>
              </div>
            </div>
            <p class="editable-field gloss">il/elle <strong>vend</strong> — no ending at all. The stem already ends in -d.</p>
          </div>
        </section>

        <!-- 3 · EXCEPTIONS -->
        <section data-slide-id="present-3" data-step="Exceptions">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">3</span> Exceptions</div>
            <h2 class="editable-field">Les irréguliers qu'il faut savoir</h2>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">The four essentials</h3>
                <table class="subj-table">
                  <tr><th></th><th>être</th><th>avoir</th><th>aller</th><th>faire</th></tr>
                  <tr><td>je/j'</td><td class="key-form">suis</td><td class="key-form">ai</td><td class="key-form">vais</td><td class="key-form">fais</td></tr>
                  <tr><td>tu</td><td>es</td><td>as</td><td>vas</td><td>fais</td></tr>
                  <tr><td>il/elle</td><td>est</td><td>a</td><td>va</td><td>fait</td></tr>
                  <tr><td>nous</td><td>sommes</td><td>avons</td><td>allons</td><td class="key-form">faisons</td></tr>
                  <tr><td>vous</td><td class="key-form">êtes</td><td>avez</td><td>allez</td><td class="key-form">faites</td></tr>
                  <tr><td>ils/elles</td><td>sont</td><td>ont</td><td>vont</td><td class="key-form">font</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Spelling changes in -ER verbs</h3>
                <p><strong>-ger</strong> → keeps the <em>e</em> before -ons: <span class="highlight hl-verb">nous mangeons</span>, nous voyageons</p>
                <p><strong>-cer</strong> → <em>ç</em> before -ons: <span class="highlight hl-verb">nous commençons</span></p>
                <p><strong>e → è</strong>: acheter → j'<span class="highlight hl-verb">achète</span>, but nous achetons</p>
                <p><strong>é → è</strong>: préférer → je <span class="highlight hl-verb">préfère</span>, but nous préférons</p>
                <p><strong>double letter</strong>: appeler → j'<span class="highlight hl-verb">appelle</span>, but nous appelons</p>
                <p class="gloss">Pattern: the change happens in je/tu/il/ils, never in nous/vous.</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field"><strong>-IR verbs that are NOT 2<sup>e</sup> groupe:</strong>
                partir, sortir, dormir, servir, mentir → <span class="highlight hl-neg">je pars, nous partons</span> (no -iss-).
                Compare: <span class="highlight hl-verb">je finis, nous finissons</span>.</p>
            </div>
          </div>
        </section>

        <!-- 4 · TRAPS -->
        <section data-slide-id="present-4" data-step="Pièges">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">4</span> Pièges</div>
            <h2 class="editable-field">⚠️ Trap Alert — where marks are lost</h2>
            <div class="two-columns">
              <div class="box red content-box">
                <h3 style="margin-top:0; color:var(--crimson);">✗ Wrong</h3>
                <p class="example-text">Nous <span class="highlight hl-neg">mangons</span> à midi.</p>
                <p class="example-text">Ils <span class="highlight hl-neg">finent</span> le travail.</p>
                <p class="example-text">Elle <span class="highlight hl-neg">va</span> ici depuis 2020.</p>
                <p class="example-text">Je <span class="highlight hl-neg">achete</span> du pain.</p>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">✓ Right</h3>
                <p class="example-text">Nous <span class="highlight hl-verb">mangeons</span> à midi. <span class="gloss">-ger keeps the e</span></p>
                <p class="example-text">Ils <span class="highlight hl-verb">finissent</span> le travail. <span class="gloss">2<sup>e</sup> groupe adds -iss-</span></p>
                <p class="example-text">Elle <span class="highlight hl-verb">habite</span> ici depuis 2020. <span class="gloss">depuis + présent</span></p>
                <p class="example-text">J'<span class="highlight hl-verb">achète</span> du pain. <span class="gloss">e → è</span></p>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field"><strong>The silent trap:</strong> <em>il parle</em> and <em>ils parlent</em> sound identical.
              Only the written <span class="highlight hl-verb">-ent</span> shows the plural — and only the written form is marked. Always check the subject before you write the ending.</p>
            </div>
          </div>
        </section>

        <!-- 5 · EXAMPLES WORKED -->
        <section data-slide-id="present-5" data-step="Exemples">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">5</span> Exemples travaillés</div>
            <h2 class="editable-field">Worked examples — follow the colours</h2>
            <div class="box blue content-box">
              <p class="example-text"><span class="highlight hl-subject">Je</span> <span class="highlight hl-verb">regarde</span> la télévision le soir.</p>
              <p class="gloss">I watch television in the evening. — subject <em>je</em> → ending <strong>-e</strong></p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text"><span class="highlight hl-subject">Nous</span> <span class="highlight hl-verb">choisissons</span> un cadeau pour Maman.</p>
              <p class="gloss">We are choosing a present for Mum. — <em>choisir</em>, 2<sup>e</sup> groupe → <strong>-issons</strong></p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text"><span class="highlight hl-subject">Mes parents</span> <span class="highlight hl-verb">attendent</span> le bus.</p>
              <p class="gloss">My parents are waiting for the bus. — <em>attendre</em>, -RE → <strong>-ent</strong></p>
            </div>
            <div class="box gold content-box fragment">
              <p class="example-text"><span class="highlight hl-subject">Vous</span> <span class="highlight hl-verb">êtes</span> en retard, mais <span class="highlight hl-subject">nous</span> <span class="highlight hl-verb">commençons</span> quand même.</p>
              <p class="gloss">You are late, but we're starting anyway. — irregular <em>être</em> + spelling change <em>commencer</em></p>
            </div>
          </div>
        </section>

        <!-- 6 · EXAMPLES IN CONTEXT -->
        <section data-slide-id="present-6" data-step="En contexte">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">6</span> En contexte</div>
            <h2 class="editable-field">In context — Entre Jeunes themes</h2>
            <p class="editable-field gloss">The same tense as it appears in your textbook lessons and in letter writing.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">L.2 — Après le bac</h3>
                <p class="example-text">Après le bac, je <span class="highlight hl-verb">veux</span> étudier la médecine.</p>
                <p class="gloss">After school, I want to study medicine.</p>
                <h3>L.5 — Les médias</h3>
                <p class="example-text">Les jeunes <span class="highlight hl-verb">passent</span> trop de temps sur leur portable.</p>
                <p class="gloss">Young people spend too much time on their phones.</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">L.7 — En pleine forme</h3>
                <p class="example-text">Je <span class="highlight hl-verb">fais</span> du sport et je <span class="highlight hl-verb">mange</span> équilibré.</p>
                <p class="gloss">I do sport and I eat a balanced diet.</p>
                <h3 style="color:var(--gold);">L.8 — L'environnement</h3>
                <p class="example-text">Nous <span class="highlight hl-verb">recyclons</span> le papier et nous <span class="highlight hl-verb">protégeons</span> la planète.</p>
                <p class="gloss">We recycle paper and we protect the planet.</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field">💡 <strong>Letter-writing tip:</strong> an informal letter usually opens in the <span class="highlight hl-verb">présent</span> —
              <em>J'espère que tu vas bien.</em> <span class="gloss">I hope you are well.</span> Learn that line by heart.</p>
            </div>
          </div>
        </section>

        <!-- 7 · PRACTICE MCQ -->
        <section data-slide-id="present-7" data-step="Pratique QCM">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">7</span> Pratique — QCM</div>
            <h2 class="editable-field">Choose the correct form</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>

              <div class="question-row" data-answer="mangeons">
                <p class="q-text">1. Nous _____ au restaurant le dimanche. <span class="gloss">(manger)</span></p>
                <div class="options">
                  <button class="option-btn">mangons</button>
                  <button class="option-btn">mangeons</button>
                  <button class="option-btn">mangeions</button>
                </div>
              </div>

              <div class="question-row" data-answer="finissent">
                <p class="q-text">2. Les élèves _____ leurs devoirs. <span class="gloss">(finir)</span></p>
                <div class="options">
                  <button class="option-btn">finent</button>
                  <button class="option-btn">finissent</button>
                  <button class="option-btn">finissons</button>
                </div>
              </div>

              <div class="question-row" data-answer="achète">
                <p class="q-text">3. Ma mère _____ des légumes au marché. <span class="gloss">(acheter)</span></p>
                <div class="options">
                  <button class="option-btn">achete</button>
                  <button class="option-btn">achète</button>
                  <button class="option-btn">achette</button>
                </div>
              </div>

              <div class="question-row" data-answer="pars">
                <p class="q-text">4. Je _____ pour Paris demain. <span class="gloss">(partir)</span></p>
                <div class="options">
                  <button class="option-btn">partis</button>
                  <button class="option-btn">pars</button>
                  <button class="option-btn">partis-je</button>
                </div>
              </div>

              <div class="question-row" data-answer="faites">
                <p class="q-text">5. Vous _____ du bruit ! <span class="gloss">(faire)</span></p>
                <div class="options">
                  <button class="option-btn">faisez</button>
                  <button class="option-btn">faites</button>
                  <button class="option-btn">faisiez</button>
                </div>
              </div>

              <div class="fib-actions">
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 8 · PRACTICE FILL-IN-THE-BLANK -->
        <section data-slide-id="present-8" data-step="Pratique — à compléter">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">8</span> Pratique — à compléter</div>
            <h2 class="editable-field">Type the correct form</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>

              <div class="question-row">
                <p class="q-text">1. Nous _____ le français depuis trois ans. <span class="gloss">(étudier)</span></p>
                <input class="fib-input" data-answer="étudions" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">2. Tu _____ toujours en retard ! <span class="gloss">(être)</span></p>
                <input class="fib-input" data-answer="es" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">3. Ils _____ la réponse. <span class="gloss">(savoir)</span></p>
                <input class="fib-input" data-answer="savent" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">4. Je _____ mes amis au café. <span class="gloss">(attendre)</span></p>
                <input class="fib-input" data-answer="attends" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">5. Vous _____ un film ce soir ? <span class="gloss">(regarder)</span></p>
                <input class="fib-input" data-answer="regardez" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>

              <div class="accent-bar">
                <span class="ab-label">Accents :</span>
                <button class="accent-key">é</button><button class="accent-key">è</button><button class="accent-key">ê</button>
                <button class="accent-key">à</button><button class="accent-key">ç</button><button class="accent-key">ù</button>
                <button class="accent-key">û</button><button class="accent-key">î</button><button class="accent-key">ô</button>
              </div>
              <div class="fib-actions">
                <button class="tb-btn fib-check student-only">✓ Vérifier</button>
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>
      </section>
      <!-- ==================================================================
           SUB-TOPIC 1.2 — L'IMPÉRATIF
           =================================================================== -->
      <section data-topic="verbes" data-topic-name="Les Verbes" data-sub="L'Impératif">

        <section data-slide-id="imperatif-1" data-step="Description">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">1</span> Description</div>
            <h2 class="editable-field">L'Impératif — giving orders and advice</h2>
            <p class="editable-field">The impératif tells someone <strong>to do something</strong>: an order, a piece of advice, an instruction, or an invitation. It is the tense of recipes, signs and advice-letters.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Only THREE forms exist</h3>
                <p>There is no <em>je</em>, no <em>il</em>, no <em>ils</em>.</p>
                <table class="subj-table">
                  <tr><td>(tu)</td><td class="key-form">Parle !</td><td class="gloss">Speak! — to a friend</td></tr>
                  <tr><td>(nous)</td><td class="key-form">Parlons !</td><td class="gloss">Let's speak!</td></tr>
                  <tr><td>(vous)</td><td class="key-form">Parlez !</td><td class="gloss">Speak! — polite/plural</td></tr>
                </table>
                <p class="gloss">⚠️ The subject pronoun <strong>disappears</strong>. Writing "Tu parle !" is wrong.</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">When you'll need it</h3>
                <p>① <strong>Order</strong> — <span class="example-text">Ferme la porte !</span> <span class="gloss">Close the door!</span></p>
                <p>② <strong>Advice</strong> — <span class="example-text">Fais du sport !</span> <span class="gloss">Do some sport!</span></p>
                <p>③ <strong>Instruction</strong> — <span class="example-text">Ajoutez le sel.</span> <span class="gloss">Add the salt.</span></p>
                <p>④ <strong>Invitation</strong> — <span class="example-text">Allons au cinéma !</span> <span class="gloss">Let's go to the cinema!</span></p>
                <p class="gloss">💡 In the exam, advice letters ("donne-moi des conseils") are written in the impératif.</p>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="imperatif-2" data-step="Formation">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">2</span> Formation</div>
            <h2 class="editable-field">La formule — présent minus the pronoun</h2>
            <div class="formula-pipeline">
              <div class="f-box"><span class="f-label">Présent</span><span class="f-value">tu parles</span></div>
              <div class="f-op">→</div>
              <div class="f-box"><span class="f-label">Drop the pronoun</span><span class="f-value">parles</span></div>
              <div class="f-op">→</div>
              <div class="f-box"><span class="f-label">-ER : drop the -s</span><span class="f-value">Parle !</span></div>
            </div>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">-ER verbs lose the final -s (tu form only)</h3>
                <table class="subj-table">
                  <tr><th>Présent</th><th>Impératif</th></tr>
                  <tr><td>tu regardes</td><td class="key-form">Regarde !</td></tr>
                  <tr><td>tu manges</td><td class="key-form">Mange !</td></tr>
                  <tr><td>tu vas</td><td class="key-form">Va !</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">-IR and -RE verbs keep the -s</h3>
                <table class="subj-table">
                  <tr><th>Présent</th><th>Impératif</th></tr>
                  <tr><td>tu finis</td><td class="key-form">Finis !</td></tr>
                  <tr><td>tu attends</td><td class="key-form">Attends !</td></tr>
                  <tr><td>tu pars</td><td class="key-form">Pars !</td></tr>
                </table>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field"><strong>Négation :</strong> wrap the verb —
              <span class="highlight hl-neg">Ne</span> parle <span class="highlight hl-neg">pas</span> !
              <span class="gloss">Don't speak!</span></p>
            </div>
          </div>
        </section>

        <section data-slide-id="imperatif-3" data-step="Exceptions">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">3</span> Exceptions</div>
            <h2 class="editable-field">Les quatre verbes irréguliers</h2>
            <div class="box blue content-box">
              <table class="subj-table">
                <tr><th>Infinitif</th><th>(tu)</th><th>(nous)</th><th>(vous)</th></tr>
                <tr><td><strong>être</strong></td><td class="key-form">sois</td><td class="key-form">soyons</td><td class="key-form">soyez</td></tr>
                <tr><td><strong>avoir</strong></td><td class="key-form">aie</td><td class="key-form">ayons</td><td class="key-form">ayez</td></tr>
                <tr><td><strong>savoir</strong></td><td class="key-form">sache</td><td class="key-form">sachons</td><td class="key-form">sachez</td></tr>
                <tr><td><strong>vouloir</strong></td><td>veuille</td><td>veuillons</td><td class="key-form">veuillez</td></tr>
              </table>
              <p class="gloss">Sois sage ! <em>Be good!</em> · N'aie pas peur ! <em>Don't be afraid!</em> · Veuillez patienter. <em>Please wait.</em> (very polite)</p>
            </div>
            <div class="box gold content-box fragment">
              <h3 style="margin-top:0; color:var(--gold);">The -s comes back before <em>y</em> and <em>en</em></h3>
              <p><span class="highlight hl-neg">Va</span> à l'école. → <span class="highlight hl-verb">Vas-y !</span> <span class="gloss">Go there!</span></p>
              <p><span class="highlight hl-neg">Mange</span> du pain. → <span class="highlight hl-verb">Manges-en !</span> <span class="gloss">Eat some!</span></p>
              <p class="gloss">The -s is added purely so the words link smoothly in speech.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="imperatif-4" data-step="Pièges">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">4</span> Pièges</div>
            <h2 class="editable-field">⚠️ Trap Alert — pronoun position flips</h2>
            <p class="editable-field">This is the single most-tested detail of the impératif.</p>
            <div class="two-columns">
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">Affirmatif — pronoun AFTER, with a hyphen</h3>
                <p class="example-text">Donne-<span class="highlight hl-pronoun">moi</span> le livre ! <span class="gloss">Give me the book!</span></p>
                <p class="example-text">Lève-<span class="highlight hl-pronoun">toi</span> ! <span class="gloss">Get up!</span></p>
                <p class="example-text">Regarde-<span class="highlight hl-pronoun">les</span> ! <span class="gloss">Look at them!</span></p>
                <p class="gloss">me → <strong>moi</strong>, te → <strong>toi</strong> in the affirmative.</p>
              </div>
              <div class="box red content-box">
                <h3 style="margin-top:0; color:var(--crimson);">Négatif — pronoun BEFORE, no hyphen</h3>
                <p class="example-text"><span class="highlight hl-neg">Ne</span> <span class="highlight hl-pronoun">me</span> donne <span class="highlight hl-neg">pas</span> le livre !</p>
                <p class="example-text"><span class="highlight hl-neg">Ne</span> <span class="highlight hl-pronoun">te</span> lève <span class="highlight hl-neg">pas</span> !</p>
                <p class="example-text"><span class="highlight hl-neg">Ne</span> <span class="highlight hl-pronoun">les</span> regarde <span class="highlight hl-neg">pas</span> !</p>
                <p class="gloss">moi/toi go back to <strong>me/te</strong>.</p>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field">✗ <em>Tu parles !</em> &nbsp;✓ <span class="highlight hl-verb">Parle !</span> — never keep the subject.<br>
              ✗ <em>Ne lève-toi pas !</em> &nbsp;✓ <span class="highlight hl-verb">Ne te lève pas !</span> — hyphen only in the affirmative.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="imperatif-5" data-step="Exemples">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">5</span> Exemples travaillés</div>
            <h2 class="editable-field">Worked examples</h2>
            <div class="box blue content-box">
              <p class="example-text"><span class="highlight hl-verb">Écoute</span> bien le professeur !</p>
              <p class="gloss">Listen to the teacher carefully! — <em>écouter</em>, -ER → no -s</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text"><span class="highlight hl-verb">Finissez</span> vos exercices avant la sonnerie.</p>
              <p class="gloss">Finish your exercises before the bell. — <em>finir</em>, vous form</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text"><span class="highlight hl-verb">Soyons</span> à l'heure demain !</p>
              <p class="gloss">Let's be on time tomorrow! — irregular <em>être</em></p>
            </div>
            <div class="box gold content-box fragment">
              <p class="example-text"><span class="highlight hl-neg">Ne</span> <span class="highlight hl-pronoun">te</span> <span class="highlight hl-verb">couche</span> <span class="highlight hl-neg">pas</span> trop tard !</p>
              <p class="gloss">Don't go to bed too late! — pronominal + negative → pronoun before the verb</p>
            </div>
          </div>
        </section>

        <section data-slide-id="imperatif-6" data-step="En contexte">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">6</span> En contexte</div>
            <h2 class="editable-field">In context — giving advice in a letter</h2>
            <p class="editable-field gloss">CBSE letters often ask you to advise a friend. The impératif is how you do it.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">L.7 — En pleine forme</h3>
                <p class="example-text"><span class="highlight hl-verb">Mange</span> des fruits et <span class="highlight hl-verb">bois</span> beaucoup d'eau.</p>
                <p class="gloss">Eat fruit and drink plenty of water.</p>
                <p class="example-text"><span class="highlight hl-neg">Ne</span> <span class="highlight hl-verb">saute</span> <span class="highlight hl-neg">pas</span> le petit déjeuner !</p>
                <p class="gloss">Don't skip breakfast!</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">L.8 — L'environnement</h3>
                <p class="example-text"><span class="highlight hl-verb">Éteignez</span> les lumières en sortant.</p>
                <p class="gloss">Switch off the lights when you leave.</p>
                <p class="example-text"><span class="highlight hl-verb">Recyclons</span> le papier et le plastique !</p>
                <p class="gloss">Let's recycle paper and plastic!</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field">💡 <strong>Exam tip:</strong> when the question says <em>« Donnez des conseils »</em>, write 3–4 impératif sentences. Mix <span class="highlight hl-verb">affirmative</span> and <span class="highlight hl-neg">negative</span> advice — it reads more naturally and shows both structures.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="imperatif-7" data-step="Pratique QCM">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">7</span> Pratique — QCM</div>
            <h2 class="editable-field">Choose the correct imperative</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row" data-answer="Regarde">
                <p class="q-text">1. _____ ce film, il est excellent ! <span class="gloss">(regarder — tu)</span></p>
                <div class="options"><button class="option-btn">Regardes</button><button class="option-btn">Regarde</button><button class="option-btn">Tu regardes</button></div>
              </div>
              <div class="question-row" data-answer="Sois">
                <p class="q-text">2. _____ patient, s'il te plaît. <span class="gloss">(être — tu)</span></p>
                <div class="options"><button class="option-btn">Es</button><button class="option-btn">Sois</button><button class="option-btn">Sois-tu</button></div>
              </div>
              <div class="question-row" data-answer="Vas-y">
                <p class="q-text">3. Tu veux aller au parc ? _____ ! <span class="gloss">(aller + y)</span></p>
                <div class="options"><button class="option-btn">Va-y</button><button class="option-btn">Vas-y</button><button class="option-btn">Allez-y-tu</button></div>
              </div>
              <div class="question-row" data-answer="Ne te lève pas">
                <p class="q-text">4. _____ si tôt le dimanche ! <span class="gloss">(se lever — tu, négatif)</span></p>
                <div class="options"><button class="option-btn">Ne lève-toi pas</button><button class="option-btn">Ne te lève pas</button><button class="option-btn">Ne toi lève pas</button></div>
              </div>
              <div class="question-row" data-answer="Donne-moi">
                <p class="q-text">5. _____ ton cahier, s'il te plaît. <span class="gloss">(donner + me)</span></p>
                <div class="options"><button class="option-btn">Donne-me</button><button class="option-btn">Me donne</button><button class="option-btn">Donne-moi</button></div>
              </div>
              <div class="fib-actions">
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="imperatif-8" data-step="Pratique — à compléter">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">8</span> Pratique — à compléter</div>
            <h2 class="editable-field">Write the imperative form</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row">
                <p class="q-text">1. _____ la fenêtre, il fait chaud ! <span class="gloss">(ouvrir — tu)</span></p>
                <input class="fib-input" data-answer="ouvre" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">2. _____ vos livres à la page 20. <span class="gloss">(prendre — vous)</span></p>
                <input class="fib-input" data-answer="prenez" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">3. _____ gentils avec votre petite sœur. <span class="gloss">(être — vous)</span></p>
                <input class="fib-input" data-answer="soyez" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">4. <span class="q-tag">CBSE 2022</span>Ne _____ (se fâcher) pas, je te prie ! <span class="gloss">(tu)</span></p>
                <input class="fib-input" data-answer="te fâche" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">5. _____ au tableau ! <span class="gloss">(aller — nous)</span></p>
                <input class="fib-input" data-answer="allons" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="accent-bar">
                <span class="ab-label">Accents :</span>
                <button class="accent-key">é</button><button class="accent-key">è</button><button class="accent-key">ê</button>
                <button class="accent-key">à</button><button class="accent-key">ç</button><button class="accent-key">ù</button>
                <button class="accent-key">û</button><button class="accent-key">î</button><button class="accent-key">ô</button>
              </div>
              <div class="fib-actions">
                <button class="tb-btn fib-check student-only">✓ Vérifier</button>
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>
      </section>

      <!-- ==================================================================
           SUB-TOPIC 1.3 — L'IMPARFAIT
           =================================================================== -->
      <section data-topic="verbes" data-topic-name="Les Verbes" data-sub="L'Imparfait">

        <section data-slide-id="imparfait-1" data-step="Description">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">1</span> Description</div>
            <h2 class="editable-field">L'Imparfait — the "background" past</h2>
            <p class="editable-field">The imparfait paints the <strong>scene</strong>: what things were like, what used to happen, what was going on. It has no clear beginning or end.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Use it for…</h3>
                <p>① <strong>Habits in the past</strong> — <span class="example-text">Chaque été, nous <span class="highlight hl-aux">allions</span> à la mer.</span> <span class="gloss">Every summer we used to go to the sea.</span></p>
                <p>② <strong>Descriptions</strong> — <span class="example-text">Il <span class="highlight hl-aux">faisait</span> froid et le ciel <span class="highlight hl-aux">était</span> gris.</span> <span class="gloss">It was cold and the sky was grey.</span></p>
                <p>③ <strong>Actions in progress</strong> — <span class="example-text">Je <span class="highlight hl-aux">dormais</span> quand tu as téléphoné.</span> <span class="gloss">I was sleeping when you called.</span></p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Signal words</h3>
                <p>Look for these — they almost always mean imparfait:</p>
                <p>
                  <span class="highlight hl-aux">souvent</span>
                  <span class="highlight hl-aux">toujours</span>
                  <span class="highlight hl-aux">chaque jour</span>
                  <span class="highlight hl-aux">tous les jours</span>
                  <span class="highlight hl-aux">d'habitude</span>
                  <span class="highlight hl-aux">autrefois</span>
                  <span class="highlight hl-aux">quand j'étais petit</span>
                </p>
                <p class="gloss">English clues: "used to…", "would always…", "was/were …-ing".</p>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="imparfait-2" data-step="Formation">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">2</span> Formation</div>
            <h2 class="editable-field">La formule — one rule, no exceptions (almost)</h2>
            <div class="formula-pipeline">
              <div class="f-box"><span class="f-label">Présent, nous form</span><span class="f-value">nous parl<u>ons</u></span></div>
              <div class="f-op">−</div>
              <div class="f-box"><span class="f-label">Remove -ons</span><span class="f-value">parl-</span></div>
              <div class="f-op">+</div>
              <div class="f-box"><span class="f-label">Terminaisons</span><span class="f-value">-ais -ais -ait -ions -iez -aient</span></div>
            </div>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">parler → parl-</h3>
                <table class="subj-table">
                  <tr><td>je</td><td class="key-form">parlais</td><td>nous</td><td class="key-form">parlions</td></tr>
                  <tr><td>tu</td><td class="key-form">parlais</td><td>vous</td><td class="key-form">parliez</td></tr>
                  <tr><td>il/elle</td><td class="key-form">parlait</td><td>ils/elles</td><td class="key-form">parlaient</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Same endings for every verb</h3>
                <p>finir → nous fin<u>iss</u>ons → je <span class="key-form">finissais</span></p>
                <p>vendre → nous vend<u>ons</u> → je <span class="key-form">vendais</span></p>
                <p>faire → nous fais<u>ons</u> → je <span class="key-form">faisais</span></p>
                <p>prendre → nous pren<u>ons</u> → je <span class="key-form">prenais</span></p>
                <p class="gloss">The nous form of the présent is the key to everything.</p>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="imparfait-3" data-step="Exceptions">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">3</span> Exceptions</div>
            <h2 class="editable-field">Les exceptions — only one real irregular</h2>
            <div class="two-columns">
              <div class="box red content-box">
                <h3 style="margin-top:0; color:var(--crimson);">ÊTRE — the only true irregular</h3>
                <p>There is no "nous êtons", so the stem is <span class="key-form">ét-</span></p>
                <table class="subj-table">
                  <tr><td>j'</td><td class="key-form">étais</td><td>nous</td><td class="key-form">étions</td></tr>
                  <tr><td>tu</td><td class="key-form">étais</td><td>vous</td><td class="key-form">étiez</td></tr>
                  <tr><td>il/elle</td><td class="key-form">était</td><td>ils/elles</td><td class="key-form">étaient</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Spelling adjustments</h3>
                <p><strong>-ger</strong> keeps the <em>e</em> before <em>a</em>:<br>
                  je <span class="highlight hl-verb">mangeais</span>, nous mangions</p>
                <p><strong>-cer</strong> takes <em>ç</em> before <em>a</em>:<br>
                  je <span class="highlight hl-verb">commençais</span>, nous commencions</p>
                <p class="gloss">The cedilla/e appears only where the ending starts with <strong>a</strong> — never in nous/vous.</p>
              </div>
            </div>
            <div class="box blue content-box fragment">
              <h3 style="margin-top:0;">The double-i verbs</h3>
              <p>Verbs whose stem already ends in <strong>-i</strong> get <span class="key-form">ii</span> in nous/vous:</p>
              <p>étudier → nous <span class="highlight hl-verb">étudiions</span>, vous étudiiez &nbsp;·&nbsp; rire → nous <span class="highlight hl-verb">riions</span> &nbsp;·&nbsp; oublier → vous <span class="highlight hl-verb">oubliiez</span></p>
              <p class="gloss">It looks like a typo, but it is correct — and it is examined.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="imparfait-4" data-step="Pièges">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">4</span> Pièges</div>
            <h2 class="editable-field">⚠️ Trap Alert — Imparfait vs Passé Composé</h2>
            <p class="editable-field">This is the most important distinction in the whole verb section.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">IMPARFAIT — the film</h3>
                <p>Background, description, habit, ongoing.</p>
                <p class="example-text">Il <span class="highlight hl-aux">pleuvait</span> et je <span class="highlight hl-aux">lisais</span> un livre.</p>
                <p class="gloss">It was raining and I was reading a book. — the scene</p>
                <p class="example-text">Quand j'<span class="highlight hl-aux">étais</span> petit, je <span class="highlight hl-aux">jouais</span> au foot.</p>
                <p class="gloss">When I was little, I used to play football. — repeated habit</p>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">PASSÉ COMPOSÉ — the photo</h3>
                <p>One finished action, a single event.</p>
                <p class="example-text">Soudain, le téléphone <span class="highlight hl-verb">a sonné</span>.</p>
                <p class="gloss">Suddenly the phone rang. — one completed event</p>
                <p class="example-text">Hier, j'<span class="highlight hl-verb">ai joué</span> au foot.</p>
                <p class="gloss">Yesterday I played football. — once, finished</p>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field"><strong>The two together:</strong>
                Je <span class="highlight hl-aux">dormais</span> <span class="gloss">(background, imparfait)</span> quand le téléphone <span class="highlight hl-verb">a sonné</span> <span class="gloss">(interrupting event, PC)</span>.<br>
                Ask yourself: <em>Was it going on, or did it happen?</em></p>
            </div>
          </div>
        </section>

        <section data-slide-id="imparfait-5" data-step="Exemples">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">5</span> Exemples travaillés</div>
            <h2 class="editable-field">Worked examples</h2>
            <div class="box blue content-box">
              <p class="example-text">Quand j'<span class="highlight hl-aux">étais</span> petit, j'<span class="highlight hl-aux">habitais</span> à Delhi.</p>
              <p class="gloss">When I was little, I lived in Delhi. — être (irregular) + habiter (regular)</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text">Nous <span class="highlight hl-aux">mangions</span> toujours ensemble le dimanche.</p>
              <p class="gloss">We always used to eat together on Sundays. — <em>manger</em>: nous mang<strong>ions</strong>, no extra e here</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text">Elle <span class="highlight hl-aux">finissait</span> ses devoirs pendant que je <span class="highlight hl-aux">regardais</span> la télé.</p>
              <p class="gloss">She was finishing her homework while I was watching TV. — two parallel ongoing actions</p>
            </div>
            <div class="box gold content-box fragment">
              <p class="example-text">Vous <span class="highlight hl-aux">étudiiez</span> le français quand vous <span class="highlight hl-aux">étiez</span> au collège.</p>
              <p class="gloss">You were studying French when you were at middle school. — double-i + être</p>
            </div>
          </div>
        </section>

        <section data-slide-id="imparfait-6" data-step="En contexte">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">6</span> En contexte</div>
            <h2 class="editable-field">In context — Entre Jeunes themes</h2>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">L.4 — Le plaisir de lire</h3>
                <p class="example-text">Autrefois, les gens <span class="highlight hl-aux">lisaient</span> plus de livres.</p>
                <p class="gloss">In the past, people used to read more books.</p>
                <h3>L.5 — Les médias</h3>
                <p class="example-text">Avant Internet, nous <span class="highlight hl-aux">écoutions</span> la radio tous les soirs.</p>
                <p class="gloss">Before the Internet, we used to listen to the radio every evening.</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">L.6 — Chacun ses goûts</h3>
                <p class="example-text">Quand il <span class="highlight hl-aux">était</span> jeune, mon père <span class="highlight hl-aux">jouait</span> de la guitare.</p>
                <p class="gloss">When he was young, my father used to play the guitar.</p>
                <h3 style="color:var(--gold);">L.8 — L'environnement</h3>
                <p class="example-text">Il y a vingt ans, l'air <span class="highlight hl-aux">était</span> beaucoup plus pur.</p>
                <p class="gloss">Twenty years ago, the air was much cleaner.</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field">💡 <strong>Writing tip:</strong> to compare "then and now", pair the two tenses —
              <em>Avant, on <span class="highlight hl-aux">jouait</span> dehors ; aujourd'hui, on <span class="highlight hl-verb">reste</span> devant un écran.</em>
              <span class="gloss">Before, we used to play outside; today we stay in front of a screen.</span></p>
            </div>
          </div>
        </section>

        <section data-slide-id="imparfait-7" data-step="Pratique QCM">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">7</span> Pratique — QCM</div>
            <h2 class="editable-field">Choose the correct imperfect form</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row" data-answer="étais">
                <p class="q-text">1. Quand j'_____ petit, j'aimais les dessins animés. <span class="gloss">(être)</span></p>
                <div class="options"><button class="option-btn">étais</button><button class="option-btn">étaient</button><button class="option-btn">suis</button></div>
              </div>
              <div class="question-row" data-answer="mangeait">
                <p class="q-text">2. Elle _____ toujours à la cantine. <span class="gloss">(manger)</span></p>
                <div class="options"><button class="option-btn">mangait</button><button class="option-btn">mangeait</button><button class="option-btn">mangeais</button></div>
              </div>
              <div class="question-row" data-answer="étudiions">
                <p class="q-text">3. Nous _____ le français ensemble. <span class="gloss">(étudier)</span></p>
                <div class="options"><button class="option-btn">étudions</button><button class="option-btn">étudiions</button><button class="option-btn">étudiaient</button></div>
              </div>
              <div class="question-row" data-answer="faisaient">
                <p class="q-text">4. Mes cousins _____ du vélo chaque dimanche. <span class="gloss">(faire)</span></p>
                <div class="options"><button class="option-btn">faisaient</button><button class="option-btn">faisions</button><button class="option-btn">font</button></div>
              </div>
              <div class="question-row" data-answer="dormais">
                <p class="q-text">5. Je _____ quand tu as sonné. <span class="gloss">(dormir)</span></p>
                <div class="options"><button class="option-btn">ai dormi</button><button class="option-btn">dormais</button><button class="option-btn">dormirai</button></div>
              </div>
              <div class="fib-actions">
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="imparfait-8" data-step="Pratique — à compléter">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">8</span> Pratique — à compléter</div>
            <h2 class="editable-field">Write the imperfect form</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row">
                <p class="q-text">1. <span class="q-tag">CBSE 2022</span>En 2021, nous _____ (étudier) souvent en ligne.</p>
                <input class="fib-input" data-answer="étudiions" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">2. Il _____ (faire) très beau ce jour-là.</p>
                <input class="fib-input" data-answer="faisait" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">3. Vous _____ (commencer) le travail à huit heures.</p>
                <input class="fib-input" data-answer="commenciez" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">4. Les enfants _____ (avoir) peur de l'orage.</p>
                <input class="fib-input" data-answer="avaient" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">5. Tu _____ (prendre) le bus tous les matins.</p>
                <input class="fib-input" data-answer="prenais" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="accent-bar">
                <span class="ab-label">Accents :</span>
                <button class="accent-key">é</button><button class="accent-key">è</button><button class="accent-key">ê</button>
                <button class="accent-key">à</button><button class="accent-key">ç</button><button class="accent-key">ù</button>
                <button class="accent-key">û</button><button class="accent-key">î</button><button class="accent-key">ô</button>
              </div>
              <div class="fib-actions">
                <button class="tb-btn fib-check student-only">✓ Vérifier</button>
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>
      </section>

      <!-- ==================================================================
           SUB-TOPIC 1.4 — LE PASSÉ COMPOSÉ
           =================================================================== -->
      <section data-topic="verbes" data-topic-name="Les Verbes" data-sub="Le Passé Composé">

        <section data-slide-id="pc-1" data-step="Description">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">1</span> Description</div>
            <h2 class="editable-field">Le Passé Composé — the finished past</h2>
            <p class="editable-field">The passé composé reports an action that <strong>happened and finished</strong>. It is the normal way to tell a story or say what you did.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Use it for…</h3>
                <p>① <strong>A completed action</strong> — <span class="example-text">J'<span class="highlight hl-verb">ai fini</span> mes devoirs.</span> <span class="gloss">I have finished my homework.</span></p>
                <p>② <strong>A sequence of events</strong> — <span class="example-text">Il <span class="highlight hl-verb">est entré</span>, il <span class="highlight hl-verb">a salué</span>, puis il <span class="highlight hl-verb">est parti</span>.</span> <span class="gloss">He came in, said hello, then left.</span></p>
                <p>③ <strong>Something that happened once</strong> — <span class="example-text">Nous <span class="highlight hl-verb">avons visité</span> Paris en 2023.</span> <span class="gloss">We visited Paris in 2023.</span></p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Signal words</h3>
                <p>
                  <span class="highlight hl-verb">hier</span>
                  <span class="highlight hl-verb">la semaine dernière</span>
                  <span class="highlight hl-verb">l'année dernière</span>
                  <span class="highlight hl-verb">soudain</span>
                  <span class="highlight hl-verb">tout à coup</span>
                  <span class="highlight hl-verb">une fois</span>
                  <span class="highlight hl-verb">en 2023</span>
                </p>
                <p class="gloss">A precise moment in time → passé composé, not imparfait.</p>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="pc-2" data-step="Formation">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">2</span> Formation</div>
            <h2 class="editable-field">La formule — two pieces, never one</h2>
            <div class="formula-pipeline">
              <div class="f-box"><span class="f-label">Sujet</span><span class="f-value">J'</span></div>
              <div class="f-op">+</div>
              <div class="f-box"><span class="f-label">Auxiliaire (présent)</span><span class="f-value">ai / suis</span></div>
              <div class="f-op">+</div>
              <div class="f-box"><span class="f-label">Participe passé</span><span class="f-value">parlé</span></div>
            </div>
            <div class="three-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">-ER → <span class="key-form">-é</span></h3>
                <p>parler → <span class="key-form">parlé</span></p>
                <p>manger → <span class="key-form">mangé</span></p>
                <p class="example-text">J'ai parlé. <span class="gloss">I spoke.</span></p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">-IR → <span class="key-form">-i</span></h3>
                <p>finir → <span class="key-form">fini</span></p>
                <p>choisir → <span class="key-form">choisi</span></p>
                <p class="example-text">Tu as fini. <span class="gloss">You finished.</span></p>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">-RE → <span class="key-form">-u</span></h3>
                <p>vendre → <span class="key-form">vendu</span></p>
                <p>attendre → <span class="key-form">attendu</span></p>
                <p class="example-text">Il a attendu. <span class="gloss">He waited.</span></p>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field"><strong>Négation surrounds the AUXILIARY, not the participle:</strong>
                Je <span class="highlight hl-neg">n'</span><span class="highlight hl-aux">ai</span> <span class="highlight hl-neg">pas</span> <span class="highlight hl-verb">parlé</span>.
                <span class="gloss">I did not speak.</span> — never <em>« ai pas parlé pas »</em></p>
            </div>
          </div>
        </section>

        <section data-slide-id="pc-3" data-step="Exceptions">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">3</span> Exceptions</div>
            <h2 class="editable-field">Irregular participles + the ÊTRE verbs</h2>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Participes passés irréguliers</h3>
                <table class="subj-table">
                  <tr><td>être</td><td class="key-form">été</td><td>avoir</td><td class="key-form">eu</td></tr>
                  <tr><td>faire</td><td class="key-form">fait</td><td>prendre</td><td class="key-form">pris</td></tr>
                  <tr><td>mettre</td><td class="key-form">mis</td><td>voir</td><td class="key-form">vu</td></tr>
                  <tr><td>lire</td><td class="key-form">lu</td><td>écrire</td><td class="key-form">écrit</td></tr>
                  <tr><td>dire</td><td class="key-form">dit</td><td>ouvrir</td><td class="key-form">ouvert</td></tr>
                  <tr><td>venir</td><td class="key-form">venu</td><td>naître</td><td class="key-form">né</td></tr>
                  <tr><td>mourir</td><td class="key-form">mort</td><td>offrir</td><td class="key-form">offert</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">The ÊTRE verbs — DR &amp; MRS VANDERTRAMP</h3>
                <p>These 16 verbs of <strong>movement and change of state</strong> use <span class="highlight hl-aux">être</span>:</p>
                <p><strong>D</strong>evenir · <strong>R</strong>evenir · <strong>M</strong>onter · <strong>R</strong>ester · <strong>S</strong>ortir ·
                   <strong>V</strong>enir · <strong>A</strong>ller · <strong>N</strong>aître · <strong>D</strong>escendre · <strong>E</strong>ntrer ·
                   <strong>R</strong>entrer · <strong>T</strong>omber · <strong>R</strong>etourner · <strong>A</strong>rriver · <strong>M</strong>ourir · <strong>P</strong>artir</p>
                <p class="gloss">➕ all <strong>pronominal</strong> verbs (se laver, se lever…) also take être.</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field"><strong>With ÊTRE, the participle agrees with the subject:</strong>
                Il est <span class="highlight hl-verb">allé</span> · Elle est <span class="highlight hl-verb">allée</span> ·
                Ils sont <span class="highlight hl-verb">allés</span> · Elles sont <span class="highlight hl-verb">allées</span>.
                <span class="gloss">Add -e for feminine, -s for plural.</span></p>
            </div>
          </div>
        </section>

        <section data-slide-id="pc-4" data-step="Pièges">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">4</span> Pièges</div>
            <h2 class="editable-field">⚠️ Trap Alert — avoir or être?</h2>
            <div class="two-columns">
              <div class="box red content-box">
                <h3 style="margin-top:0; color:var(--crimson);">✗ Wrong</h3>
                <p class="example-text">Elle <span class="highlight hl-neg">a allé</span> au marché.</p>
                <p class="example-text">Ils sont <span class="highlight hl-neg">arrivé</span>.</p>
                <p class="example-text">Nous <span class="highlight hl-neg">avons</span> nous levés.</p>
                <p class="example-text">J'ai <span class="highlight hl-neg">prendu</span> le bus.</p>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">✓ Right</h3>
                <p class="example-text">Elle <span class="highlight hl-aux">est</span> <span class="highlight hl-verb">allée</span> au marché. <span class="gloss">aller = être + agreement</span></p>
                <p class="example-text">Ils sont <span class="highlight hl-verb">arrivés</span>. <span class="gloss">plural → -s</span></p>
                <p class="example-text">Nous <span class="highlight hl-aux">nous sommes</span> <span class="highlight hl-verb">levés</span>. <span class="gloss">pronominal → être</span></p>
                <p class="example-text">J'ai <span class="highlight hl-verb">pris</span> le bus. <span class="gloss">irregular participle</span></p>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field"><strong>Decision routine — do this every time:</strong>
                ① Is it pronominal (se/me/te/nous/vous)? → <span class="highlight hl-aux">être</span>.
                ② Is it in DR &amp; MRS VANDERTRAMP? → <span class="highlight hl-aux">être</span>.
                ③ Otherwise → <span class="highlight hl-aux">avoir</span>.
                ④ If être, <strong>check the agreement</strong> before moving on.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="pc-5" data-step="Exemples">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">5</span> Exemples travaillés</div>
            <h2 class="editable-field">Worked examples</h2>
            <div class="box blue content-box">
              <p class="example-text"><span class="highlight hl-subject">J'</span><span class="highlight hl-aux">ai</span> <span class="highlight hl-verb">regardé</span> un film hier soir.</p>
              <p class="gloss">I watched a film last night. — regular -ER, avoir</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text"><span class="highlight hl-subject">Ma sœur</span> <span class="highlight hl-aux">est</span> <span class="highlight hl-verb">partie</span> à sept heures.</p>
              <p class="gloss">My sister left at seven. — <em>partir</em> = être, feminine subject → partie</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text"><span class="highlight hl-subject">Nous</span> <span class="highlight hl-aux">avons</span> <span class="highlight hl-verb">pris</span> le train pour Lyon.</p>
              <p class="gloss">We took the train to Lyon. — irregular participle <em>pris</em></p>
            </div>
            <div class="box gold content-box fragment">
              <p class="example-text"><span class="highlight hl-subject">Elles</span> <span class="highlight hl-pronoun">se</span> <span class="highlight hl-aux">sont</span> <span class="highlight hl-verb">rencontrées</span> dans la rue.</p>
              <p class="gloss">They met in the street. — pronominal → être + feminine plural agreement</p>
            </div>
          </div>
        </section>

        <section data-slide-id="pc-6" data-step="En contexte">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">6</span> En contexte</div>
            <h2 class="editable-field">In context — telling what happened</h2>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">L.3 — Chercher du travail</h3>
                <p class="example-text">J'<span class="highlight hl-verb">ai envoyé</span> mon CV et j'<span class="highlight hl-verb">ai obtenu</span> un entretien.</p>
                <p class="gloss">I sent my CV and I got an interview.</p>
                <h3>L.5 — Les médias</h3>
                <p class="example-text">Hier, j'<span class="highlight hl-verb">ai lu</span> un article intéressant sur Internet.</p>
                <p class="gloss">Yesterday I read an interesting article on the Internet.</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">L.10 — Vive la République !</h3>
                <p class="example-text">La Révolution française <span class="highlight hl-verb">a commencé</span> en 1789.</p>
                <p class="gloss">The French Revolution began in 1789.</p>
                <h3 style="color:var(--gold);">L.8 — L'environnement</h3>
                <p class="example-text">Les élèves <span class="highlight hl-aux">sont</span> <span class="highlight hl-verb">allés</span> planter des arbres.</p>
                <p class="gloss">The pupils went to plant trees.</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field">💡 <strong>Letter tip:</strong> when you describe a holiday or an event, alternate the two past tenses —
              <em>Il <span class="highlight hl-aux">faisait</span> beau, alors nous <span class="highlight hl-verb">sommes allés</span> à la plage.</em>
              <span class="gloss">The weather was nice, so we went to the beach.</span></p>
            </div>
          </div>
        </section>

        <section data-slide-id="pc-7" data-step="Pratique QCM">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">7</span> Pratique — QCM</div>
            <h2 class="editable-field">Choose the correct passé composé</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row" data-answer="est allée">
                <p class="q-text">1. Marie _____ au cinéma samedi. <span class="gloss">(aller)</span></p>
                <div class="options"><button class="option-btn">a allé</button><button class="option-btn">est allée</button><button class="option-btn">est allé</button></div>
              </div>
              <div class="question-row" data-answer="avons pris">
                <p class="q-text">2. Nous _____ le petit déjeuner à huit heures. <span class="gloss">(prendre)</span></p>
                <div class="options"><button class="option-btn">avons prendu</button><button class="option-btn">avons pris</button><button class="option-btn">sommes pris</button></div>
              </div>
              <div class="question-row" data-answer="n'ai pas fini">
                <p class="q-text">3. Je _____ mes devoirs. <span class="gloss">(ne pas finir)</span></p>
                <div class="options"><button class="option-btn">n'ai pas fini</button><button class="option-btn">ai pas fini</button><button class="option-btn">n'ai fini pas</button></div>
              </div>
              <div class="question-row" data-answer="sont nés">
                <p class="q-text">4. Mes frères _____ en 2010. <span class="gloss">(naître)</span></p>
                <div class="options"><button class="option-btn">ont né</button><button class="option-btn">sont nés</button><button class="option-btn">sont naîtres</button></div>
              </div>
              <div class="question-row" data-answer="s'est levé">
                <p class="q-text">5. Il _____ très tôt ce matin. <span class="gloss">(se lever)</span></p>
                <div class="options"><button class="option-btn">a se levé</button><button class="option-btn">s'est levé</button><button class="option-btn">est se levé</button></div>
              </div>
              <div class="fib-actions">
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="pc-8" data-step="Pratique — à compléter">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">8</span> Pratique — à compléter</div>
            <h2 class="editable-field">Write the passé composé</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row">
                <p class="q-text">1. <span class="q-tag">CBSE 2022</span>Nous _____ (se rencontrer) au club la semaine dernière.</p>
                <input class="fib-input" data-answer="nous sommes rencontrés|nous sommes rencontré(e)s|nous sommes rencontrées" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">2. <span class="q-tag">CBSE 2022</span>L'année dernière, elles _____ (se rencontrer) dans la rue.</p>
                <input class="fib-input" data-answer="se sont rencontrées" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">3. J'_____ (écrire) une longue lettre à mon ami.</p>
                <input class="fib-input" data-answer="ai écrit" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">4. Vous _____ (descendre) par l'escalier.</p>
                <input class="fib-input" data-answer="êtes descendus|êtes descendu|êtes descendues|êtes descendu(e)s" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">5. Tu _____ (ne pas voir) ce film ?</p>
                <input class="fib-input" data-answer="n'as pas vu" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="accent-bar">
                <span class="ab-label">Accents :</span>
                <button class="accent-key">é</button><button class="accent-key">è</button><button class="accent-key">ê</button>
                <button class="accent-key">à</button><button class="accent-key">ç</button><button class="accent-key">ù</button>
                <button class="accent-key">û</button><button class="accent-key">î</button><button class="accent-key">ô</button>
              </div>
              <div class="fib-actions">
                <button class="tb-btn fib-check student-only">✓ Vérifier</button>
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>
      </section>
      <!-- ==================================================================
           SUB-TOPIC 1.5 — LE PLUS-QUE-PARFAIT
           =================================================================== -->
      <section data-topic="verbes" data-topic-name="Les Verbes" data-sub="Le Plus-que-parfait">

        <section data-slide-id="pqp-1" data-step="Description">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">1</span> Description</div>
            <h2 class="editable-field">Le Plus-que-parfait — the past before the past</h2>
            <p class="editable-field">When you are already telling a story in the past and you need to go <strong>one step further back</strong>, you use the plus-que-parfait. English: "had done".</p>
            <div class="box blue content-box">
              <h3 style="margin-top:0;">Two past actions, one order</h3>
              <p class="example-text">Quand je suis arrivé, il <span class="highlight hl-aux">était</span> déjà <span class="highlight hl-verb">parti</span>.</p>
              <p class="gloss">When I arrived, he had already left. — <em>leaving</em> happened BEFORE <em>arriving</em>.</p>
              <div class="formula-pipeline" style="margin-top:10px;">
                <div class="f-box" style="border-color:var(--purple);"><span class="f-label">1<sup>er</sup> — le plus ancien</span><span class="f-value" style="color:var(--purple);">il était parti</span></div>
                <div class="f-op">→</div>
                <div class="f-box"><span class="f-label">2<sup>e</sup> — plus récent</span><span class="f-value">je suis arrivé</span></div>
                <div class="f-op">→</div>
                <div class="f-box" style="border-color:var(--green);"><span class="f-label">3<sup>e</sup> — maintenant</span><span class="f-value" style="color:var(--green);">je raconte</span></div>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field"><strong>Signal words:</strong>
                <span class="highlight hl-aux">déjà</span>
                <span class="highlight hl-aux">avant</span>
                <span class="highlight hl-aux">quand</span>
                <span class="highlight hl-aux">parce que</span> — they often introduce the earlier action.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="pqp-2" data-step="Formation">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">2</span> Formation</div>
            <h2 class="editable-field">La formule — auxiliaire à l'IMPARFAIT</h2>
            <div class="formula-pipeline">
              <div class="f-box"><span class="f-label">Sujet</span><span class="f-value">J'</span></div>
              <div class="f-op">+</div>
              <div class="f-box"><span class="f-label">avoir / être à l'imparfait</span><span class="f-value">avais / étais</span></div>
              <div class="f-op">+</div>
              <div class="f-box"><span class="f-label">Participe passé</span><span class="f-value">parlé</span></div>
            </div>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Avec AVOIR — parler</h3>
                <table class="subj-table">
                  <tr><td>j'</td><td class="key-form">avais parlé</td><td>nous</td><td class="key-form">avions parlé</td></tr>
                  <tr><td>tu</td><td class="key-form">avais parlé</td><td>vous</td><td class="key-form">aviez parlé</td></tr>
                  <tr><td>il/elle</td><td class="key-form">avait parlé</td><td>ils/elles</td><td class="key-form">avaient parlé</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Avec ÊTRE — aller</h3>
                <table class="subj-table">
                  <tr><td>j'</td><td class="key-form">étais allé(e)</td><td>nous</td><td class="key-form">étions allé(e)s</td></tr>
                  <tr><td>tu</td><td class="key-form">étais allé(e)</td><td>vous</td><td class="key-form">étiez allé(e)(s)</td></tr>
                  <tr><td>il/elle</td><td class="key-form">était allé(e)</td><td>ils/elles</td><td class="key-form">étaient allé(e)s</td></tr>
                </table>
              </div>
            </div>
            <p class="editable-field gloss">Same auxiliary choice and same agreement rules as the passé composé — only the auxiliary's tense changes.</p>
          </div>
        </section>

        <section data-slide-id="pqp-3" data-step="Exceptions">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">3</span> Exceptions</div>
            <h2 class="editable-field">Les exceptions — inherited from the passé composé</h2>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Same ÊTRE verbs</h3>
                <p>DR &amp; MRS VANDERTRAMP + all pronominal verbs still take <span class="highlight hl-aux">être</span>:</p>
                <p class="example-text">Elle <span class="highlight hl-aux">était</span> <span class="highlight hl-verb">venue</span>. <span class="gloss">She had come.</span></p>
                <p class="example-text">Ils <span class="highlight hl-aux">s'étaient</span> <span class="highlight hl-verb">levés</span> tôt. <span class="gloss">They had got up early.</span></p>
                <p class="example-text">Nous <span class="highlight hl-aux">étions</span> <span class="highlight hl-verb">restés</span> à la maison. <span class="gloss">We had stayed at home.</span></p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Same irregular participles</h3>
                <p>faire → <span class="key-form">avait fait</span> · prendre → <span class="key-form">avait pris</span></p>
                <p>voir → <span class="key-form">avait vu</span> · écrire → <span class="key-form">avait écrit</span></p>
                <p>être → <span class="key-form">avait été</span> · avoir → <span class="key-form">avait eu</span></p>
                <p class="gloss">Nothing new to learn — if you know the passé composé, you know this.</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <h3 style="margin-top:0; color:var(--green);">Special use: <em>si</em> + plus-que-parfait</h3>
              <p class="example-text"><span class="highlight hl-aux">Si</span> j'<span class="highlight hl-verb">avais su</span>, je serais venu.</p>
              <p class="gloss">If I had known, I would have come. — regret about the past. The <em>si</em> clause takes the plus-que-parfait.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="pqp-4" data-step="Pièges">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">4</span> Pièges</div>
            <h2 class="editable-field">⚠️ Trap Alert — Passé Composé vs Plus-que-parfait</h2>
            <div class="two-columns">
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">PASSÉ COMPOSÉ — "did"</h3>
                <p class="example-text">Il <span class="highlight hl-verb">a mangé</span> à midi.</p>
                <p class="gloss">He ate at noon. — a single past event</p>
                <p class="example-text">Nous <span class="highlight hl-verb">sommes arrivés</span> en retard.</p>
                <p class="gloss">We arrived late.</p>
              </div>
              <div class="box blue content-box">
                <h3 style="margin-top:0;">PLUS-QUE-PARFAIT — "had done"</h3>
                <p class="example-text">Il <span class="highlight hl-aux">avait</span> <span class="highlight hl-verb">mangé</span> avant de sortir.</p>
                <p class="gloss">He had eaten before going out. — earlier than another past event</p>
                <p class="example-text">Nous <span class="highlight hl-aux">étions</span> <span class="highlight hl-verb">arrivés</span> quand il a téléphoné.</p>
                <p class="gloss">We had arrived when he phoned.</p>
              </div>
            </div>
            <div class="box red content-box fragment">
              <p class="editable-field">✗ <em>Quand je suis arrivé, il <span class="highlight hl-neg">est parti</span>.</em> — this means he left <em>after</em> I arrived.<br>
              ✓ <em>Quand je suis arrivé, il <span class="highlight hl-verb">était parti</span>.</em> — he had already gone. <strong>The tense changes the meaning.</strong></p>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field">💡 <strong>Quick test:</strong> if you can say "<em>had</em>" in English, use the plus-que-parfait. If you'd say just "<em>did</em>", use the passé composé.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="pqp-5" data-step="Exemples">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">5</span> Exemples travaillés</div>
            <h2 class="editable-field">Worked examples</h2>
            <div class="box blue content-box">
              <p class="example-text">J'<span class="highlight hl-aux">avais</span> déjà <span class="highlight hl-verb">fini</span> mes devoirs quand mes amis sont arrivés.</p>
              <p class="gloss">I had already finished my homework when my friends arrived.</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text">Elle <span class="highlight hl-aux">était</span> <span class="highlight hl-verb">sortie</span> avant l'orage.</p>
              <p class="gloss">She had gone out before the storm. — <em>sortir</em> = être, feminine → sortie</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text">Nous n'<span class="highlight hl-aux">avions</span> <span class="highlight hl-neg">pas</span> <span class="highlight hl-verb">compris</span> la question.</p>
              <p class="gloss">We had not understood the question. — negation wraps the auxiliary</p>
            </div>
            <div class="box gold content-box fragment">
              <p class="example-text">Ils <span class="highlight hl-aux">s'étaient</span> <span class="highlight hl-verb">couchés</span> tôt parce qu'ils étaient fatigués.</p>
              <p class="gloss">They had gone to bed early because they were tired. — pronominal → être + agreement</p>
            </div>
          </div>
        </section>

        <section data-slide-id="pqp-6" data-step="En contexte">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">6</span> En contexte</div>
            <h2 class="editable-field">In context — Entre Jeunes themes</h2>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">L.3 — Chercher du travail</h3>
                <p class="example-text">Il n'a pas eu le poste parce qu'il <span class="highlight hl-verb">n'avait pas préparé</span> l'entretien.</p>
                <p class="gloss">He didn't get the job because he had not prepared for the interview.</p>
                <h3>L.4 — Le plaisir de lire</h3>
                <p class="example-text">J'<span class="highlight hl-verb">avais lu</span> ce roman avant de voir le film.</p>
                <p class="gloss">I had read that novel before seeing the film.</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">L.2 — Après le bac</h3>
                <p class="example-text">Elle <span class="highlight hl-verb">avait choisi</span> sa filière avant même les résultats.</p>
                <p class="gloss">She had chosen her stream even before the results.</p>
                <h3 style="color:var(--gold);">L.7 — En pleine forme</h3>
                <p class="example-text">Le médecin a dit qu'il <span class="highlight hl-verb">avait trop mangé</span>.</p>
                <p class="gloss">The doctor said that he had eaten too much.</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field">💡 <strong>Reported speech link:</strong> when <em>« J'ai fini »</em> becomes indirect speech, it turns into
              <em>Il a dit qu'il <span class="highlight hl-verb">avait fini</span>.</em> The plus-que-parfait is what the passé composé becomes — you will meet this again in <strong>Le Discours Indirect</strong>.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="pqp-7" data-step="Pratique QCM">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">7</span> Pratique — QCM</div>
            <h2 class="editable-field">Choose the correct pluperfect</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row" data-answer="avait déjà commencé">
                <p class="q-text">1. Quand nous sommes entrés, le film _____. <span class="gloss">(déjà commencer)</span></p>
                <div class="options"><button class="option-btn">a déjà commencé</button><button class="option-btn">avait déjà commencé</button><button class="option-btn">était déjà commencé</button></div>
              </div>
              <div class="question-row" data-answer="était partie">
                <p class="q-text">2. Elle _____ avant mon arrivée. <span class="gloss">(partir)</span></p>
                <div class="options"><button class="option-btn">avait parti</button><button class="option-btn">était partie</button><button class="option-btn">était parti</button></div>
              </div>
              <div class="question-row" data-answer="avaient pris">
                <p class="q-text">3. Ils _____ le train de sept heures. <span class="gloss">(prendre)</span></p>
                <div class="options"><button class="option-btn">avaient pris</button><button class="option-btn">étaient pris</button><button class="option-btn">avaient prendu</button></div>
              </div>
              <div class="question-row" data-answer="m'étais levé">
                <p class="q-text">4. Je _____ très tôt ce matin-là. <span class="gloss">(se lever)</span></p>
                <div class="options"><button class="option-btn">m'avais levé</button><button class="option-btn">m'étais levé</button><button class="option-btn">étais me levé</button></div>
              </div>
              <div class="question-row" data-answer="avais su">
                <p class="q-text">5. Si j'_____, je serais venu. <span class="gloss">(savoir)</span></p>
                <div class="options"><button class="option-btn">ai su</button><button class="option-btn">avais su</button><button class="option-btn">saurais</button></div>
              </div>
              <div class="fib-actions">
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="pqp-8" data-step="Pratique — à compléter">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">8</span> Pratique — à compléter</div>
            <h2 class="editable-field">Write the plus-que-parfait</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row">
                <p class="q-text">1. Nous _____ (finir) le travail avant midi.</p>
                <input class="fib-input" data-answer="avions fini" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">2. Elles _____ (arriver) avant nous.</p>
                <input class="fib-input" data-answer="étaient arrivées" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">3. Tu _____ (ne pas voir) ce match.</p>
                <input class="fib-input" data-answer="n'avais pas vu" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">4. Il _____ (faire) ses valises la veille.</p>
                <input class="fib-input" data-answer="avait fait" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">5. Vous _____ (se coucher) très tard.</p>
                <input class="fib-input" data-answer="vous étiez couchés|vous étiez couché|vous étiez couchées|vous étiez couché(e)s" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="accent-bar">
                <span class="ab-label">Accents :</span>
                <button class="accent-key">é</button><button class="accent-key">è</button><button class="accent-key">ê</button>
                <button class="accent-key">à</button><button class="accent-key">ç</button><button class="accent-key">ù</button>
                <button class="accent-key">û</button><button class="accent-key">î</button><button class="accent-key">ô</button>
              </div>
              <div class="fib-actions">
                <button class="tb-btn fib-check student-only">✓ Vérifier</button>
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>
      </section>

      <!-- ==================================================================
           SUB-TOPIC 1.6 — LE FUTUR SIMPLE
           =================================================================== -->
      <section data-topic="verbes" data-topic-name="Les Verbes" data-sub="Le Futur Simple">

        <section data-slide-id="futur-1" data-step="Description">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">1</span> Description</div>
            <h2 class="editable-field">Le Futur Simple — what will happen</h2>
            <p class="editable-field">The futur simple states what <strong>will</strong> happen. It is the tense of plans, predictions and promises.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">Use it for…</h3>
                <p>① <strong>Future plans</strong> — <span class="example-text">L'année prochaine, j'<span class="highlight hl-subject">irai</span> en France.</span> <span class="gloss">Next year I will go to France.</span></p>
                <p>② <strong>Predictions</strong> — <span class="example-text">Il <span class="highlight hl-subject">pleuvra</span> demain.</span> <span class="gloss">It will rain tomorrow.</span></p>
                <p>③ <strong>Promises</strong> — <span class="example-text">Je te <span class="highlight hl-subject">téléphonerai</span> ce soir.</span> <span class="gloss">I will phone you tonight.</span></p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">Futur proche vs futur simple</h3>
                <p><strong>Futur proche</strong> = aller + infinitif — very near, already decided:</p>
                <p class="example-text">Je <span class="highlight hl-aux">vais partir</span> maintenant. <span class="gloss">I'm about to leave.</span></p>
                <p><strong>Futur simple</strong> — further away, more formal, written:</p>
                <p class="example-text">Je <span class="highlight hl-subject">partirai</span> l'année prochaine. <span class="gloss">I will leave next year.</span></p>
                <p class="gloss">In letters and exams, prefer the futur simple.</p>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="futur-2" data-step="Formation">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">2</span> Formation</div>
            <h2 class="editable-field">La formule — infinitif + terminaisons d'AVOIR</h2>
            <div class="formula-pipeline">
              <div class="f-box"><span class="f-label">Infinitif entier</span><span class="f-value">parler</span></div>
              <div class="f-op">+</div>
              <div class="f-box"><span class="f-label">Terminaisons</span><span class="f-value">-ai -as -a -ons -ez -ont</span></div>
              <div class="f-op">=</div>
              <div class="f-box"><span class="f-label">Futur</span><span class="f-value">je parlerai</span></div>
            </div>
            <div class="three-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">-ER — parler</h3>
                <table class="subj-table">
                  <tr><td>je</td><td class="key-form">parlerai</td></tr>
                  <tr><td>tu</td><td class="key-form">parleras</td></tr>
                  <tr><td>il/elle</td><td class="key-form">parlera</td></tr>
                  <tr><td>nous</td><td class="key-form">parlerons</td></tr>
                  <tr><td>vous</td><td class="key-form">parlerez</td></tr>
                  <tr><td>ils/elles</td><td class="key-form">parleront</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">-IR — finir</h3>
                <table class="subj-table">
                  <tr><td>je</td><td class="key-form">finirai</td></tr>
                  <tr><td>tu</td><td class="key-form">finiras</td></tr>
                  <tr><td>il/elle</td><td class="key-form">finira</td></tr>
                  <tr><td>nous</td><td class="key-form">finirons</td></tr>
                  <tr><td>vous</td><td class="key-form">finirez</td></tr>
                  <tr><td>ils/elles</td><td class="key-form">finiront</td></tr>
                </table>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">-RE — vendre (drop the e)</h3>
                <table class="subj-table">
                  <tr><td>je</td><td class="key-form">vendrai</td></tr>
                  <tr><td>tu</td><td class="key-form">vendras</td></tr>
                  <tr><td>il/elle</td><td class="key-form">vendra</td></tr>
                  <tr><td>nous</td><td class="key-form">vendrons</td></tr>
                  <tr><td>vous</td><td class="key-form">vendrez</td></tr>
                  <tr><td>ils/elles</td><td class="key-form">vendront</td></tr>
                </table>
              </div>
            </div>
            <p class="editable-field gloss">🔑 The stem <strong>always ends in -r</strong>. If yours doesn't, it's wrong.</p>
          </div>
        </section>

        <section data-slide-id="futur-3" data-step="Exceptions">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">3</span> Exceptions</div>
            <h2 class="editable-field">Les radicaux irréguliers — learn these 14</h2>
            <p class="editable-field">The endings never change. Only the <strong>stem</strong> is irregular — and the same stems return in the conditionnel.</p>
            <div class="two-columns">
              <div class="box blue content-box">
                <table class="subj-table">
                  <tr><th>Infinitif</th><th>Radical</th><th>Exemple</th></tr>
                  <tr><td>être</td><td class="key-form">ser-</td><td>je serai</td></tr>
                  <tr><td>avoir</td><td class="key-form">aur-</td><td>j'aurai</td></tr>
                  <tr><td>aller</td><td class="key-form">ir-</td><td>j'irai</td></tr>
                  <tr><td>faire</td><td class="key-form">fer-</td><td>je ferai</td></tr>
                  <tr><td>pouvoir</td><td class="key-form">pourr-</td><td>je pourrai</td></tr>
                  <tr><td>vouloir</td><td class="key-form">voudr-</td><td>je voudrai</td></tr>
                  <tr><td>devoir</td><td class="key-form">devr-</td><td>je devrai</td></tr>
                </table>
              </div>
              <div class="box gold content-box">
                <table class="subj-table">
                  <tr><th>Infinitif</th><th>Radical</th><th>Exemple</th></tr>
                  <tr><td>savoir</td><td class="key-form">saur-</td><td>je saurai</td></tr>
                  <tr><td>venir</td><td class="key-form">viendr-</td><td>je viendrai</td></tr>
                  <tr><td>voir</td><td class="key-form">verr-</td><td>je verrai</td></tr>
                  <tr><td>envoyer</td><td class="key-form">enverr-</td><td>j'enverrai</td></tr>
                  <tr><td>recevoir</td><td class="key-form">recevr-</td><td>je recevrai</td></tr>
                  <tr><td>falloir</td><td class="key-form">faudr-</td><td>il faudra</td></tr>
                  <tr><td>pleuvoir</td><td class="key-form">pleuvr-</td><td>il pleuvra</td></tr>
                </table>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field"><strong>Spelling changes carry over:</strong> acheter → j'<span class="key-form">achèterai</span> · appeler → j'<span class="key-form">appellerai</span> · payer → je <span class="key-form">paierai</span>. The è / double letter appears in <strong>every</strong> person of the futur.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="futur-4" data-step="Pièges">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">4</span> Pièges</div>
            <h2 class="editable-field">⚠️ Trap Alert — <em>quand</em> takes the future in French</h2>
            <div class="two-columns">
              <div class="box red content-box">
                <h3 style="margin-top:0; color:var(--crimson);">English logic — wrong here</h3>
                <p class="example-text">✗ Quand il <span class="highlight hl-neg">arrive</span>, je lui parlerai.</p>
                <p class="gloss">English says "When he arrives…" with a present tense.</p>
                <p class="example-text">✗ Dès que tu <span class="highlight hl-neg">es</span> prêt, nous partirons.</p>
              </div>
              <div class="box green content-box">
                <h3 style="margin-top:0; color:var(--green);">French logic — future in BOTH clauses</h3>
                <p class="example-text">✓ Quand il <span class="highlight hl-subject">arrivera</span>, je lui <span class="highlight hl-subject">parlerai</span>.</p>
                <p class="gloss">When he arrives, I will speak to him.</p>
                <p class="example-text">✓ Dès que tu <span class="highlight hl-subject">seras</span> prêt, nous <span class="highlight hl-subject">partirons</span>.</p>
                <p class="gloss">As soon as you are ready, we will leave.</p>
              </div>
            </div>
            <div class="box gold content-box fragment">
              <p class="editable-field">These conjunctions all trigger the future when the action is in the future:
                <span class="highlight hl-aux">quand</span>
                <span class="highlight hl-aux">lorsque</span>
                <span class="highlight hl-aux">dès que</span>
                <span class="highlight hl-aux">aussitôt que</span>
                <span class="highlight hl-aux">tant que</span></p>
              <p class="gloss">⚠️ But after <strong>si</strong> (if), never use the future: <em>Si tu <span class="highlight hl-verb">viens</span>, je serai content.</em></p>
            </div>
          </div>
        </section>

        <section data-slide-id="futur-5" data-step="Exemples">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">5</span> Exemples travaillés</div>
            <h2 class="editable-field">Worked examples</h2>
            <div class="box blue content-box">
              <p class="example-text">Demain, je <span class="highlight hl-subject">finirai</span> mon projet.</p>
              <p class="gloss">Tomorrow I will finish my project. — regular: infinitive + ai</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text">Nous <span class="highlight hl-subject">serons</span> à Paris en juillet.</p>
              <p class="gloss">We will be in Paris in July. — être → ser-</p>
            </div>
            <div class="box blue content-box fragment">
              <p class="example-text">Mes parents <span class="highlight hl-subject">achèteront</span> une nouvelle voiture le mois prochain.</p>
              <p class="gloss">My parents will buy a new car next month. — acheter → achèter-</p>
            </div>
            <div class="box gold content-box fragment">
              <p class="example-text">Quand tu <span class="highlight hl-subject">auras</span> le temps, tu me <span class="highlight hl-subject">verras</span>.</p>
              <p class="gloss">When you have time, you will see me. — <em>quand</em> + futur in both clauses</p>
            </div>
          </div>
        </section>

        <section data-slide-id="futur-6" data-step="En contexte">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">6</span> En contexte</div>
            <h2 class="editable-field">In context — talking about your plans</h2>
            <div class="two-columns">
              <div class="box blue content-box">
                <h3 style="margin-top:0;">L.2 — Après le bac</h3>
                <p class="example-text">Après le bac, je <span class="highlight hl-subject">m'inscrirai</span> à l'université.</p>
                <p class="gloss">After school, I will enrol at university.</p>
                <h3>L.3 — Chercher du travail</h3>
                <p class="example-text">Je <span class="highlight hl-subject">enverrai</span> ma candidature la semaine prochaine.</p>
                <p class="gloss">I will send my application next week.</p>
              </div>
              <div class="box gold content-box">
                <h3 style="margin-top:0; color:var(--gold);">L.8 — L'environnement</h3>
                <p class="example-text">Si nous ne faisons rien, la planète <span class="highlight hl-subject">souffrira</span>.</p>
                <p class="gloss">If we do nothing, the planet will suffer. — note: <em>si</em> + présent, main clause futur</p>
                <h3 style="color:var(--gold);">L.7 — En pleine forme</h3>
                <p class="example-text">Tu <span class="highlight hl-subject">te sentiras</span> mieux si tu dors davantage.</p>
                <p class="gloss">You will feel better if you sleep more.</p>
              </div>
            </div>
            <div class="box green content-box fragment">
              <p class="editable-field">💡 <strong>Letter tip:</strong> close a letter with the futur —
              <em>J'<span class="highlight hl-subject">attendrai</span> ta réponse avec impatience.</em>
              <span class="gloss">I will wait for your reply eagerly.</span> A ready-made closing line worth memorising.</p>
            </div>
          </div>
        </section>

        <section data-slide-id="futur-7" data-step="Pratique QCM">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">7</span> Pratique — QCM</div>
            <h2 class="editable-field">Choose the correct future form</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row" data-answer="irai">
                <p class="q-text">1. L'été prochain, j'_____ en Espagne. <span class="gloss">(aller)</span></p>
                <div class="options"><button class="option-btn">allerai</button><button class="option-btn">irai</button><button class="option-btn">vais</button></div>
              </div>
              <div class="question-row" data-answer="seras">
                <p class="q-text">2. <span class="q-tag">CBSE 2022</span>Ma petite, tu _____ heureuse car nous partons en vacances ! <span class="gloss">(être)</span></p>
                <div class="options"><button class="option-btn">seras</button><button class="option-btn">series</button><button class="option-btn">étais</button></div>
              </div>
              <div class="question-row" data-answer="achèteront">
                <p class="q-text">3. <span class="q-tag">CBSE 2022</span>Mes parents _____ une nouvelle voiture le mois prochain. <span class="gloss">(acheter)</span></p>
                <div class="options"><button class="option-btn">acheteront</button><button class="option-btn">achèteront</button><button class="option-btn">achetaient</button></div>
              </div>
              <div class="question-row" data-answer="arrivera">
                <p class="q-text">4. Quand il _____, nous mangerons. <span class="gloss">(arriver)</span></p>
                <div class="options"><button class="option-btn">arrive</button><button class="option-btn">arrivera</button><button class="option-btn">arriverait</button></div>
              </div>
              <div class="question-row" data-answer="ferons">
                <p class="q-text">5. Nous _____ nos devoirs après le dîner. <span class="gloss">(faire)</span></p>
                <div class="options"><button class="option-btn">ferons</button><button class="option-btn">faisons</button><button class="option-btn">ferions</button></div>
              </div>
              <div class="fib-actions">
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
        </section>

        <section data-slide-id="futur-8" data-step="Pratique — à compléter">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">8</span> Pratique — à compléter</div>
            <h2 class="editable-field">Write the futur simple</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row">
                <p class="q-text">1. Je vous _____ (envoyer) le document demain.</p>
                <input class="fib-input" data-answer="enverrai" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">2. Elle _____ (venir) avec nous au concert.</p>
                <input class="fib-input" data-answer="viendra" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">3. Vous _____ (pouvoir) sortir après le contrôle.</p>
                <input class="fib-input" data-answer="pourrez" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">4. Dès que tu _____ (savoir) la réponse, appelle-moi.</p>
                <input class="fib-input" data-answer="sauras" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">5. Ils _____ (vendre) leur maison l'année prochaine.</p>
                <input class="fib-input" data-answer="vendront" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="accent-bar">
                <span class="ab-label">Accents :</span>
                <button class="accent-key">é</button><button class="accent-key">è</button><button class="accent-key">ê</button>
                <button class="accent-key">à</button><button class="accent-key">ç</button><button class="accent-key">ù</button>
                <button class="accent-key">û</button><button class="accent-key">î</button><button class="accent-key">ô</button>
              </div>
              <div class="fib-actions">
                <button class="tb-btn fib-check student-only">✓ Vérifier</button>
                <button class="tb-btn reveal-answers teacher-only">👁️ Afficher les réponses</button>
                <button class="retry-btn student-only">🔄 Recommencer</button>
                <span class="score-display">Score : 0 / 5</span>
              </div>
            </div>
          </div>
