/* ---------------- Pick-a-Student randomizer ---------------- */
let pickTimer = null, pickCurrentClass = null;
function openPick(){ $('#pickStudentModal').classList.add('open'); showPickClasses(); }
function closePick(){ clearInterval(pickTimer); $('#pickStudentModal').classList.remove('open'); }
function showPickClasses(){
  clearInterval(pickTimer);
  $('#pickClassRow').style.display = '';
  $('#pickStage').hidden = true;
}
function spinPick(cls){
  pickCurrentClass = cls;
  const roster = ROSTERS[cls] || [];
  if (!roster.length) return;
  $('#pickClassRow').style.display = 'none';
  $('#pickStage').hidden = false;
  $('#pickSub').textContent = `Class ${cls} · ${roster.length} students`;
  const nameEl = $('#pickName');
  nameEl.classList.remove('landed'); nameEl.classList.add('spinning');
  clearInterval(pickTimer);
  const started = Date.now();
  pickTimer = setInterval(() => {
    nameEl.textContent = roster[(Math.random() * roster.length) | 0];
    if (Date.now() - started >= 1500){
      clearInterval(pickTimer);
      const chosen = roster[(Math.random() * roster.length) | 0];
      nameEl.textContent = chosen;
      nameEl.classList.remove('spinning'); nameEl.classList.add('landed');
      try { burstConfetti(); } catch(e){}
      playSound('correct');
    }
  }, 70);
}

/* ---------------- Projector / fullscreen mode ---------------- */
function isFs(){ return !!document.fullscreenElement; }
function setProjector(on){
  document.body.classList.toggle('projector-mode', on);
  ls.set('projector', on ? '1' : '0');
  try { Deck.layout(); } catch(e){}
  setTimeout(() => { try { Deck.layout(); } catch(e){} }, 260);
}
function toggleProjector(){
  const on = !document.body.classList.contains('projector-mode');
  setProjector(on);
  if (on && !isFs()){ document.documentElement.requestFullscreen && document.documentElement.requestFullscreen().catch(()=>{}); }
  if (!on && isFs()){ document.exitFullscreen && document.exitFullscreen(); }
}
document.addEventListener('fullscreenchange', () => {
  // Leaving fullscreen via Esc should also drop projector mode
  if (!isFs() && document.body.classList.contains('projector-mode')) setProjector(false);
});

/* ---------------- Click-to-hear French (Web Speech; offline-capable) ---------------- */
const speechOK = ('speechSynthesis' in window) && ('SpeechSynthesisUtterance' in window);
let frVoice = null;
function pickFrenchVoice(){
  if (!speechOK) return;
  const vs = speechSynthesis.getVoices() || [];
  frVoice = vs.find(v => /fr-FR/i.test(v.lang)) || vs.find(v => /^fr/i.test(v.lang)) || null;
}
if (speechOK){ pickFrenchVoice(); speechSynthesis.onvoiceschanged = pickFrenchVoice; }
function speakFrench(text, btn){
  if (!speechOK || !text) return;
  try {
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'fr-FR'; u.rate = 0.92; if (frVoice) u.voice = frVoice;
    if (btn){ btn.classList.add('speaking'); u.onend = u.onerror = () => btn.classList.remove('speaking'); }
    speechSynthesis.speak(u);
  } catch(e){}
}
/* Strip glosses / arrows so only the French is read aloud */
function frenchTextOf(el){
  const clone = el.cloneNode(true);
  clone.querySelectorAll('.gloss, .q-tag, .audio-btn').forEach(n => n.remove());
  return (clone.textContent || '').replace(/→.*$/,'').replace(/\s+/g,' ').trim();
}
/* Add a small 🔊 button to every French example, once */
function injectAudioButtons(){
  if (!speechOK) return;
  $$('.example-text, .tl-d-ex').forEach(el => {
    if (el.dataset.audio) return;
    el.dataset.audio = '1';
    const b = document.createElement('button');
    b.className = 'audio-btn'; b.type = 'button'; b.title = 'Hear it in French'; b.textContent = '🔊';
    b.addEventListener('click', ev => { ev.stopPropagation(); speakFrench(frenchTextOf(el), b); });
    el.appendChild(b);
  });
}

/* ---------------- Interactive Tense Timeline ---------------- */
function initTimeline(){
  const hero = $('.tl-hero'); if (!hero) return;
  let data = {};
  try { data = JSON.parse(hero.dataset.tl || '{}'); } catch(e){ console.warn('Timeline data parse failed', e); return; }
  let verb = Object.keys(data)[0]; if (!verb) return;
  const detail = $('.tl-detail', hero);

  function renderNodes(){
    const set = data[verb] || {};
    $$('.tl-node', hero).forEach(node => {
      const k = node.dataset.tense; const d = set[k]; if (!d) return;
      const fEl = $('.tl-formula', node); if (fEl) fEl.textContent = d.formula;
      const eEl = $('.tl-ex', node); if (eEl) eEl.textContent = d.ex;
    });
    // moods also carry per-verb example text on their button title
    $$('.tl-mood', hero).forEach(m => { const d = set[m.dataset.tense]; if (d) m.title = d.ex + ' — ' + d.gloss; });
  }
  function showDetail(k){
    const d = (data[verb] || {})[k]; if (!d || !detail) return;
    $$('.tl-node', hero).forEach(n => n.classList.toggle('active', n.dataset.tense === k));
    detail.innerHTML =
      `<h3>${d.fr} <span style="color:var(--text-muted);font-weight:600;font-size:.75em;">(${d.en})</span></h3>` +
      `<span class="tl-formula" style="font-size:.8rem;">${d.formula}</span>` +
      `<p class="tl-d-ex">${d.ex}</p>` +
      `<span class="gloss">${d.gloss}</span>`;
    injectAudioButtons();
  }
  $$('.tl-node', hero).forEach(node => node.addEventListener('click', () => showDetail(node.dataset.tense)));
  $$('.tl-verb-btn', hero).forEach(b => b.addEventListener('click', () => {
    verb = b.dataset.verb;
    $$('.tl-verb-btn', hero).forEach(x => x.classList.toggle('is-on', x === b));
    renderNodes();
    const active = $('.tl-node.active', hero) || $('.tl-node', hero);
    if (active) showDetail(active.dataset.tense);
    playSound('pop');
  }));
  $$('.tl-mood', hero).forEach(m => m.addEventListener('click', () => {
    m.classList.toggle('active');
    const k = m.dataset.tense;
    if (m.classList.contains('active')) showDetail(k);
  }));
  renderNodes();
  const first = $('.tl-node', hero);
  if (first) showDetail(first.dataset.tense);
  // Optional GSAP flourish (pure-CSS layout already complete without it)
  window.__enhanceTimeline = () => {
    if (typeof gsap === 'undefined') return;
    try { gsap.from(hero.querySelectorAll('.tl-node'), { y: 24, opacity: 0, duration: .5, stagger: .06, ease: 'back.out(1.6)' }); } catch(e){}
  };
  if (typeof gsap !== 'undefined') window.__enhanceTimeline();
}

/* ---------------- Progressive-enhancement hooks ---------------- */
window.__gsapReady = () => { if (window.__enhanceTimeline) window.__enhanceTimeline(); };
window.__lucideReady = () => { try { if (window.lucide) lucide.createIcons(); } catch(e){} };

/* ---------------- Step-reveal hint (how many reveals remain) ---------------- */
function updateStepHint(){
  const el = $('#stepHint'); if (!el) return;
  const cur = Deck.getCurrentSlide(); if (!cur){ el.classList.remove('show'); return; }
  const frags = $$('.fragment', cur);
  const shown = frags.filter(f => f.classList.contains('visible')).length;
  const remaining = frags.length - shown;
  if (remaining > 0){
    el.textContent = `▸ ${remaining} more reveal${remaining>1?'s':''} on this slide (press → / Space)`;
    el.classList.add('show');
    clearTimeout(el._t); el._t = setTimeout(() => el.classList.remove('show'), 1600);
  } else {
    el.classList.remove('show');
  }
}

/* ---------------- Wiring ---------------- */
function toggleFullscreen(){
  if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(()=>{});
  else if (document.exitFullscreen) document.exitFullscreen();
}

$('#prevBtn').onclick = () => Deck.prev();
$('#nextBtn').onclick = () => Deck.next();
$('#fsBtn').onclick = toggleFullscreen;
$('#topicMenuBtn').onclick = e => { e.stopPropagation(); $('#topicMenu').classList.toggle('open'); };
$('#searchBtn').onclick = openSearch;
$('#modeBtn').onclick = toggleMode;
$('#lightBtn').onclick = toggleLight;
$('#printBtn').onclick = printTopic;
$('#sidebarBtn').onclick = () => { document.body.classList.toggle('sidebar-hidden'); setTimeout(()=>Deck.layout(), 320); };
$('#shortcutsBtn').onclick = e => { e.stopPropagation(); $('#shortcutsModal').classList.toggle('open'); };
$('#settingsBtn').onclick = e => { e.stopPropagation(); $('#settingsPanel').classList.toggle('open'); };
$('#soundBtn').onclick = () => { soundOn = !soundOn; ls.set('sound', soundOn ? '1':'0'); refreshSoundBtn(); playSound('pop'); };

/* Clue-word Hint toggle (delegated; used by Révision Mixte) */
document.addEventListener('click', e => {
  const hb = e.target.closest('.hint-btn'); if (!hb) return;
  e.stopPropagation();
  const row = hb.closest('.question-row'); if (!row) return;
  const box = row.querySelector('.hint-box'); if (!box) return;
  box.hidden = !box.hidden;
  hb.textContent = box.hidden ? '💡 Hint' : '🙈 Hide';
});

/* Phase-1 button wiring (guarded so missing elements never throw) */
(function wirePhase1(){
  const on = (id, fn, ev='click') => { const el = $('#'+id); if (el) el.addEventListener(ev, fn); };
  on('pickStudentBtn', e => { e.stopPropagation(); openPick(); });
  on('pickCloseBtn', closePick);
  on('pickAgainBtn', () => spinPick(pickCurrentClass));
  on('pickBackBtn', showPickClasses);
  $$('#pickClassRow .pick-class-btn').forEach(b => b.addEventListener('click', () => spinPick(b.dataset.class)));
  on('projectorBtn', toggleProjector);
  on('projectorBtn2', toggleProjector);
  on('printTopicBtn2', printTopic);
  on('printBookBtn', printBook);
})();

$('#themeSelect').onchange = e => applyTheme(e.target.value);
$('#fontFamilySelect').onchange = e => {
  document.documentElement.style.setProperty('--custom-font-family', e.target.value);
  ls.set('font_family', e.target.value);
};
$('#fontSizeSelect').onchange = e => {
  document.documentElement.style.setProperty('--custom-font-scale', e.target.value);
  ls.set('font_scale', e.target.value); Deck.layout();
};
$('#textColorSelect').onchange = e => {
  if (e.target.value){ document.documentElement.style.setProperty('--custom-text-color', e.target.value); ls.set('text_color', e.target.value); }
  else { document.documentElement.style.removeProperty('--custom-text-color'); ls.del('text_color'); }
};
$('#liveEditToggle').onchange = e => setLiveEdit(e.target.checked);
$('#saveEditsBtn').onclick = saveEdits;
$$('#settingsPanel [data-add]').forEach(b => b.addEventListener('click', () => addElement(b.dataset.add)));
$('#resetBtn').onclick = () => {
  ['theme','font_family','font_scale','text_color','slide_edits','visited','known','mode','sound','lightTheme','darkTheme']
    .forEach(k => ls.del(k));
  location.reload();
};
$('#searchInput').addEventListener('input', e => runSearch(e.target.value));
$('#searchInput').addEventListener('keydown', e => {
  if (e.key === 'Escape') $('#searchModal').classList.remove('open');
  if (e.key === 'Enter'){ const f = $('.search-hit', $('#searchResults')); if (f) f.click(); }
});
document.addEventListener('click', e => {
  if (!e.target.closest('#topicMenu') && !e.target.closest('#topicMenuBtn')) $('#topicMenu').classList.remove('open');
  if (!e.target.closest('#settingsPanel') && !e.target.closest('#settingsBtn')) $('#settingsPanel').classList.remove('open');
  if (!e.target.closest('#shortcutsModal') && !e.target.closest('#shortcutsBtn')) $('#shortcutsModal').classList.remove('open');
  if (!e.target.closest('.search-modal') && !e.target.closest('#searchBtn')) $('#searchModal').classList.remove('open');
  // Click the dark backdrop of the pick modal (but not its card) to close
  if (e.target.id === 'pickStudentModal') closePick();
});

document.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'){ e.preventDefault(); openSearch(); return; }
  if (e.key === 'Escape' && $('#pickStudentModal').classList.contains('open')){ closePick(); return; }
  if (document.activeElement && (document.activeElement.isContentEditable ||
      document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT')) return;
  const k = e.key.toLowerCase();
  if (k === 'f') toggleFullscreen();
  else if (k === 'p'){ e.preventDefault(); toggleProjector(); }
  else if (k === 's') $('#settingsPanel').classList.toggle('open');
  else if (k === 't') toggleMode();
  else if (k === 'l') toggleLight();
  else if (k === 'e'){ const cb = $('#liveEditToggle'); cb.checked = !cb.checked; setLiveEdit(cb.checked); }
  else if (e.key === '?') $('#shortcutsModal').classList.toggle('open');
});

/* ---------------- Boot ---------------- */
applyTheme(ls.get('theme','theme-slate'));
applyMode(ls.get('mode','mode-teacher'));
refreshSoundBtn();
const ff = ls.get('font_family'); if (ff){ document.documentElement.style.setProperty('--custom-font-family', ff); $('#fontFamilySelect').value = ff; }
const fs = ls.get('font_scale'); if (fs){ document.documentElement.style.setProperty('--custom-font-scale', fs); $('#fontSizeSelect').value = fs; }
const tc = ls.get('text_color'); if (tc){ document.documentElement.style.setProperty('--custom-text-color', tc); $('#textColorSelect').value = tc; }

/* Deep links, guarded — works on file:// and http://, no-ops when sandboxed. */
function syncHash(){
  const i = Deck.getIndices();
  try { history.replaceState(null, '', '#/' + i.h + '/' + i.v); } catch(e){}
}
function restoreFromHash(){
  try {
    const m = /^#\/(\d+)(?:\/(\d+))?/.exec(location.hash || '');
    if (m) Deck.slide(parseInt(m[1],10), parseInt(m[2] || '0',10));
  } catch(e){}
}

let booted = false;
function boot(){
  if (booted) return; booted = true;
  restoreEdits();
  $$('.quiz-container').forEach(initQuizContainer);
  initFlipCards();
  initLabs();
  buildSearchIndex();
  renderTopicMenu();
  applyMode(ls.get('mode','mode-teacher'));   // re-apply: enables/disables the widgets just wired
  restoreFromHash();
  updateHud();
  startFX();
  /* Phase-1 module init */
  initTimeline();
  injectAudioButtons();
  if (ls.get('projector','0') === '1') setProjector(true);
  if (window.lucide) { try { lucide.createIcons(); } catch(e){} }
  if (typeof gsap !== 'undefined' && window.__enhanceTimeline) window.__enhanceTimeline();
  /* Reveal's first internal layout can run before the shell's inset is applied,
     leaving slides sized to the whole window. Force one once styles have settled,
     and again when the Google Fonts land and change text metrics. */
  requestAnimationFrame(() => { try { Deck.layout(); } catch(e){} });
  if (document.fonts && document.fonts.ready){
    document.fonts.ready.then(() => { try { Deck.layout(); } catch(e){} });
  }
  Deck.on('slidechanged', () => { updateHud(); syncHash(); playSound('slide'); injectAudioButtons(); });
  Deck.on('fragmentshown', () => { updateHud(); updateStepHint(); });
  Deck.on('fragmenthidden', () => { updateHud(); updateStepHint(); });
}

/* Boot even if Reveal's init promise rejects — the deck itself still renders,
   and losing the whole UI to a History API restriction is not acceptable. */
Deck.initialize().then(boot).catch(err => { console.warn('Reveal init warning:', err); boot(); });

})();
</script>
</body>
</html>
