<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Master Grammar App — CBSE Class 10 French</title>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Poppins:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&family=Space+Grotesk:wght@500;700&family=Comic+Neue:wght@400;700&family=Cinzel:wght@600;800&display=swap" rel="stylesheet">

<!-- ===== ONLINE PROGRESSIVE ENHANCEMENTS (never block; app is fully usable if these fail) =====
     GSAP  -> animates the tense-timeline hero (pure-CSS fallback if absent)
     Lucide-> optional crisp UI icons (emoji fallback if absent)
     Both load async; the engine feature-detects and also exposes __gsapReady / __lucideReady hooks. -->
<script async src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"
        onload="window.__gsapReady && window.__gsapReady()"></script>
<script async src="https://unpkg.com/lucide@0.400.0/dist/umd/lucide.min.js"
        onload="window.__lucideReady && window.__lucideReady()"></script>

