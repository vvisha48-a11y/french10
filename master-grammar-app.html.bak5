        <section data-slide-id="neg-pers-8" data-step="Pratique — à compléter">
          <div class="slide-card">
            <div class="flag-stripe"></div>
            <div class="step-ribbon"><span class="sr-n">8</span> Pratique — à compléter</div>
            <h2 class="editable-field">Répondez négativement</h2>
            <div class="quiz-container">
              <div class="quiz-progress-bar"><div class="quiz-progress-fill"></div></div>
              <div class="question-row">
                <p class="q-text">1. Tu attends quelqu'un ? → Non, je _____.</p>
                <input class="fib-input" data-answer="n'attends personne" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">2. Quelqu'un a téléphoné ? → Non, _____ a téléphoné.</p>
                <input class="fib-input" data-answer="personne n'" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">3. Tu as rencontré quelqu'un ? → Non, je _____.</p>
                <input class="fib-input" data-answer="n'ai rencontré personne" placeholder="votre réponse"><span class="fib-verdict"></span>
              </div>
              <div class="question-row">
                <p class="q-text">4. Tout le monde est parti ? → Non, il n'y a _____ ici.</p>
